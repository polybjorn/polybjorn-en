---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, ArrowUp } from '@lucide/astro';
import { cloudinaryUrl } from '../../data/made.js';

export async function getStaticPaths() {
  // Drafts are filtered from the index and the feed, but a page was still
  // built for them and listed in the sitemap - unlisted, not unpublished.
  // Keep them reachable in dev so they can be previewed.
  const projects = await getCollection('projects', ({ data }) =>
    // A preview build is a PRODUCTION build, so gating on PROD alone hid a
    // draft from site-preview: an empty listing and a 404 for the one page the
    // preview existed to show. PREVIEW is the same flag src/pages/dev/[view].astro
    // already gates on. A plain `npm run build`, which is what deploys, still
    // emits no draft route.
    import.meta.env.DEV || process.env.PREVIEW === '1' || !data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout lang="en" title={`${project.data.title} - Bjørn A. Andersen`} description={project.data.description} enOnly links={project.data.links}>
  <style>
    body {
      background: #1e2228;
      color: #dde1e7;
      font-family: 'Piazzolla', serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    main {
      width: 100%;
      max-width: 720px;
      /* The last line needs room under it, and the to-top arrow sits in the
         bottom 3rem of the viewport. 4rem was enough while every article ended
         in a button block; two of them no longer do. */
      padding: 3rem 1.5rem 7rem;
    }
    .back-home {
      position: fixed;
      top: calc(1rem - 4px);
      left: max(1rem, env(safe-area-inset-left, 0px) + 0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0.75;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .back-home:hover { opacity: 1; color: #fff; }
    .back-home.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.5rem);
    }
    .cover-btn {
      display: block;
      width: 100%;
      max-width: 640px;
      margin: 0 auto 1rem;
      padding: 0;
      border: none;
      background: transparent;
      cursor: zoom-in;
    }
    .cover-btn:focus-visible { outline: 2px solid #6AAEEE; outline-offset: 2px; }
    .cover {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: contain;
      margin: 0;
    }
    h1 { font-size: 2.2rem; margin-bottom: 0.5rem; font-weight: 700; line-height: 1.2; text-align: center; }
    .meta { color: #8a8f99; font-size: 0.95rem; margin-bottom: 2.5rem; text-align: center; }
    /* Separated by a middot rather than a second line, so the header keeps
       its shape whether or not a piece has been revised. A work in progress
       gets neither: it shows its latest date alone, because the day it first
       went up says little about a piece that is still moving.

       The spacing is a margin, not spaces inside content: the build minifies
       `content: " \00b7 "` down to `content:" \00b7"`, which leaves the dot
       welded to the word after it. */
    .meta-upd::before { content: "\00b7"; margin: 0 0.45em; }
    /* A piece still in progress marks its latest date in the warm accent and
       names the status on hover or focus. The label fades with opacity rather
       than visibility so a screen reader still reads it in place. */
    .meta-live { color: #e8b775; position: relative; cursor: help; outline: none; }
    .meta-live:focus-visible { outline: 2px solid #6AAEEE; outline-offset: 2px; border-radius: 2px; }
    .meta-wip {
      position: absolute; left: 50%; top: calc(100% + 4px); transform: translateX(-50%); z-index: 5;
      white-space: nowrap; font-size: 0.8rem; padding: 0.3rem 0.55rem; border-radius: 5px;
      background: #1e2228; border: 1px solid #2a2e35; color: #e8b775;
      opacity: 0; pointer-events: none; transition: opacity 0.12s;
    }
    .meta-live:hover .meta-wip,
    .meta-live:focus .meta-wip { opacity: 1; }

    article :global(h2) { font-size: 1.5rem; margin: 2rem 0 0.75rem; font-weight: 700; }
    article :global(h3) { font-size: 1.2rem; margin: 1.5rem 0 0.5rem; font-weight: 700; }
    article :global(p) { margin-bottom: 1.1rem; line-height: 1.65; }
    article :global(a) { color: #6AAEEE; text-decoration: underline; }
    article :global(ul), article :global(ol) { margin: 0 0 1.1rem 1.5rem; }
    article :global(li) { margin-bottom: 0.35rem; line-height: 1.6; }
    article :global(strong) { font-weight: 700; }
    article :global(em) { font-style: italic; }
    article :global(blockquote) {
      border-left: 3px solid #6AAEEE;
      padding: 0.25rem 0 0.25rem 1rem;
      margin: 1.25rem 0;
      color: #b5bac3;
      font-style: italic;
    }
    article :global(code) {
      background: #2a2f37;
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-size: 0.9em;
    }
    article :global(pre) {
      background: #15181d;
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
      margin: 1.25rem 0;
    }
    /* Shiki sets its theme background inline, so it needs overriding to match */
    article :global(pre.astro-code) { background: #15181d !important; }
    article :global(pre code) { background: transparent; padding: 0; }
    article :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
      /* Centred rather than flush left, so an image narrower than the 720px
         column does not sit off to one side. */
      display: block;
      margin: 1.25rem auto;
    }
    article :global(.img-zoom) {
      display: block;
      width: 100%;
      margin: 1.25rem 0 0;
      padding: 0;
      border: none;
      background: transparent;
      cursor: zoom-in;
    }
    article :global(.img-zoom:focus-visible) { outline: 2px solid #6AAEEE; outline-offset: 2px; }
    article :global(.img-zoom img) { display: block; margin: 0; }
    article :global(.img-caption) {
      font-size: 0.9rem;
      text-align: center;
      background: #15181d;
      border-radius: 0 0 6px 6px;
      margin: -0.35rem 0 1.25rem;
      padding: 0.2rem 1.4rem 1rem;
      line-height: 1.5;
    }
    /* Markdown tables rendered to nothing but browser defaults until now -
       no project page had used one, so the gap was invisible. Borders and
       muted head follow the rest of this sheet. */
    article :global(table) {
      /* fit-content centres a narrow table instead of stretching two columns
         across the whole measure; max-width plus the overflow below still lets
         a wide one scroll on a phone. */
      width: fit-content;
      max-width: 100%;
      border-collapse: collapse;
      margin: 1.25rem auto;
      font-size: 0.95rem;
      line-height: 1.5;
      font-variant-numeric: tabular-nums;
      display: block;
      overflow-x: auto;
    }
    article :global(thead th) {
      text-align: left;
      font-weight: 600;
      color: #8a8f99;
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      padding: 0 0.85rem 0.5rem;
      border-bottom: 1px solid #2a2f37;
      white-space: nowrap;
    }
    article :global(tbody td) {
      padding: 0.55rem 0.85rem;
      border-bottom: 1px solid #22262d;
      vertical-align: baseline;
      /* A wrapped cell in a two-column table reads as two rows. The table
         already scrolls sideways when it has to, so let it. */
      white-space: nowrap;
    }
    @media (max-width: 560px) {
      /* Below this the nowrap would push a wide table into a scrollbar for
         every reader, which is worse than a wrapped line. */
      article :global(tbody td) { white-space: normal; }
    }
    article :global(tbody tr:last-child td) { border-bottom: none; }
    /* The tables here are label-then-number, so the measure reads better
       aligned right. Revisit if one ever ends in prose. */
    article :global(thead th:not(:first-child)),
    article :global(tbody td:not(:first-child)) { text-align: right; }
    /* Bar chart in markup rather than an image. A 748px SVG scaled into a
       327px phone rendered its axis text at under 5px; this reflows, the
       labels stay real text at real size, and updating a number is an edit
       rather than regenerating a file. Colours validated for colour-blind
       separation before use. */
    /* One grid for the whole figure, with every row a subgrid of it, so all
       rows share the columns. The two side columns take equal flex so the
       bars sit centred on the page; 1.7 is what keeps a side column at least
       as wide as the longest label at full width, and past that the label
       column only grows by what it needs. */
    /* Equal side columns, so the bars sit centred on the page - 1.7 is what
       keeps a side column at least as wide as the longest label at full width.
       A max-content number column pulled the bars off centre by half its
       width, which is the trade: the bars are the thing being compared, so
       they get the symmetry and the control lives with a wider column. */
    article :global(.mchart) {
      margin: 1.5rem 0; display: grid;
      grid-template-columns: 1fr minmax(0, 1.7fr) 1fr; column-gap: 0.6rem;
    }
    article :global(.mchart > *) { grid-column: 1 / -1; }
    /* Sits below the bars, so the spacing goes above it. */
    article :global(.mchart-cap) {
      color: #8a8f99; font-size: 0.85rem; margin-top: 0.7rem; line-height: 1.5;
      text-align: center;
    }
    /* One line over the chart: what the colours mean on the left, the view
       control on the right. They wrap to their own lines on a narrow screen
       and both centre there, which is where the key sat before the buttons
       existed. Without JS the buttons never appear, and :has puts the key
       back in the middle rather than leaving it hanging at the left. */
    article :global(.mchart-head) {
      display: grid; grid-template-columns: subgrid; align-items: center;
      gap: 0.35rem 0.6rem; margin-bottom: 0.9rem;
    }
    /* Both on one line. The switch ends on the numbers' right edge, which
       pulls it left across the bar column; the key runs from the figure's left
       edge and needs 266px of the 418 that leaves, so the two clear each other
       with room to spare. An earlier version of this wrapped, and the cause
       was the key being confined to the 300px bar column - not its type. */
    article :global(.mchart-modes) { grid-row: 1; }
    article :global(.mchart-head .mchart-key) { grid-row: 1; }
    /* The head sits on the chart's own columns: the key runs from the figure's
       left edge, the control starts where the numbers do. The key wants about
       510px and the bar column is 300, so starting it at the bars forces it
       onto two lines - it takes the label column as well and holds one line
       instead, which is what it is for. Centring it across those two columns
       was the version that lined up with nothing. */
    article :global(.mchart-head .mchart-key) {
      grid-column: 1 / 3; justify-content: flex-start; flex-wrap: nowrap;
    }
    /* Translate rather than margin: a percentage in translate is the element's
       own width, so this lands the switch's right edge on 3rem from the
       column start - the numbers' right edge - whatever the two words are. */
    article :global(.mchart-modes) {
      grid-column: 3 / 4; justify-self: start;
      transform: translateX(calc(3rem - 100%));
    }
    /* Alone - no JS, so no control - the key centres over the whole figure
       again, which is where it sat before there was anything beside it. */
    article :global(.mchart-head:has(.mchart-modes[hidden]) .mchart-key) {
      grid-column: 1 / -1; justify-content: center;
    }
    article :global(.mchart-key) {
      display: flex; flex-wrap: wrap; gap: 0.35rem 1rem;
      color: #b5bac3; font-size: 0.85rem;
      /* Centred when it is alone; beside the buttons it sits left, which is
         what the head's space-between gives it. */
      justify-content: center;
    }
    article :global(.mchart-key span) { display: inline-flex; align-items: center; gap: 0.4rem; }
    article :global(.mchart-sw) { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
    article :global(.mchart-row) {
      display: grid; grid-template-columns: subgrid;
      align-items: center; margin-bottom: 0.4rem;
    }
    /* No underline: four of them stacked in a column is noisier than the data.
       The links still have to be findable, so they carry the brighter body ink
       against the muted label grey, and the underline comes back on hover and
       keyboard focus. Accent blue is avoided deliberately - it sits right next
       to a coloured bar and the two compete, and the bars now carry that
       exact blue. */
    article :global(.mchart-label a) {
      color: #dde1e7;
      text-decoration: none;
    }
    article :global(.mchart-label a:hover),
    article :global(.mchart-label a:focus-visible) { text-decoration: underline; }
    /* Same reasoning inside tables, where a link would otherwise underline a
       whole row of cells. */
    article :global(table a) { color: #dde1e7; text-decoration: none; }
    article :global(table a:hover),
    article :global(table a:focus-visible) { text-decoration: underline; }
    article :global(.mchart-label) {
      font-size: 0.85rem; color: #b5bac3; text-align: right;
      line-height: 1.35;
      white-space: nowrap;
    }
    /* Groups are by how a method works, not by whether it has a model in it:
       a reranker sits beside past links as a second pass over the same
       shortlist, and colour still says which ones carry a model. */
    article :global(.mchart-group) {
      color: #dde1e7; font-size: 0.75rem; text-transform: uppercase;
      letter-spacing: 0.06em; margin: 1rem 0 0.4rem; text-align: center;
    }
    article :global(.mchart-head + .mchart-group) { margin-top: 0; }
    /* Focus as well as hover, because a tap on a phone focuses the span and
       never hovers it. The box is a direct child of the row so it can sit in
       the bar column: an absolutely positioned grid child takes its grid area
       as its containing block, both lines explicit because an auto end line
       means the container's edge, which gives it exactly the bars' width, below
       the hovered row and clear of the labels. */
    article :global(.mchart-row) { position: relative; }
    article :global(.mchart-tip) { cursor: help; outline: none; color: #6AAEEE; }
    article :global(.mchart-tip:focus-visible) { outline: 2px solid #6AAEEE; outline-offset: 2px; border-radius: 2px; }
    article :global(.mchart-tipbox) {
      position: absolute; grid-column: 2 / 3; grid-row: 1 / 2;
      top: calc(100% + 4px); left: 0; right: 0; z-index: 5;
      padding: 0.5rem 0.65rem; border-radius: 5px;
      background: #1e2228; border: 1px solid #2a2e35; color: #dde1e7;
      font-size: 0.8rem; line-height: 1.45; text-align: left;
      white-space: normal; text-transform: none; letter-spacing: normal;
      visibility: hidden; opacity: 0; outline: none;
      transition: opacity 0.12s, visibility 0s linear 0.2s;
    }
    /* The box is focusable and counts itself, so clicking into it to select
       text keeps it open instead of blurring the term that opened it. The
       delay on hiding lets the pointer cross the gap between term and box. */
    article :global(.mchart-row:has(.mchart-tip:hover, .mchart-tip:focus, .mchart-tipbox:hover, .mchart-tipbox:focus) > .mchart-tipbox) {
      visibility: visible; opacity: 1; transition-delay: 0s;
    }
    article :global(.mchart-track) { background: #23272e; border-radius: 3px; height: 1.15rem; }
    /* No width transition: the bars change length behind a fade now, and a
       tween running underneath it showed through as the table came back. */
    article :global(.mchart-bar) { height: 100%; border-radius: 3px; min-width: 2px; }
    /* Left, so a number sits against the bar it belongs to - right-aligned in
       a column wider than the digits, a short value like 2.6% drifted away
       from its own bar. The width is set rather than left to stretch: the
       cell fills a 1fr column otherwise, and then the numbers have no right
       edge for the switch above them to line up with. 3rem clears "55 min",
       the longest thing either view puts here. */
    article :global(.mchart-val) {
      font-size: 0.85rem; font-variant-numeric: tabular-nums; color: #dde1e7;
      width: 3rem; justify-self: start;
    }
    /* Two segments and a thumb that slides between them, because there is one
       question - which measure the bars are showing - and two answers. A
       dropdown made the reader open something to see the choice; here both
       words are on screen and either is one tap, which is what mattered on a
       phone. The rows sort by whatever is picked, so the order always matches
       what is being looked at.
       A bar shows one measure at a time either way: recall is a linear
       percentage and a run is 0.24s to 55min, and one geometry carrying both
       scales misreads both.
       It ships hidden and the script reveals it - without the script the chart
       is what it always was, and a control that did nothing would be worse
       than none. [hidden] needs the explicit rule for rows and headings, which
       set display themselves. */
    article :global(.mchart-modes) {
      position: relative; display: grid; grid-template-columns: 1fr 1fr;
      background: #23272e; border: 1px solid #2a2e35; border-radius: 999px;
      padding: 2px;
      /* Its own padding, border and the segment's inset would set the last
         label a padding-width inside the box's right edge. Pushing the box out
         by exactly that lands the word on the numbers' right edge. */
      margin-right: calc(-0.55rem - 3px);
    }
    article :global(.mchart-modes[hidden]),
    article :global(.mchart-group[hidden]),
    article :global(.mchart-row[hidden]) { display: none; }
    /* The thumb is one element that moves, not a background that jumps
       between two: half the track less its padding, so translating it by its
       own width lands it exactly on the other segment. */
    article :global(.mchart-thumb) {
      position: absolute; top: 2px; bottom: 2px; left: 2px;
      width: calc(50% - 2px); border-radius: 999px; background: #2a2f37;
      border: 1px solid #4a5058;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    article :global(.mchart[data-mode="speed"] .mchart-thumb) {
      transform: translateX(100%);
    }
    @media (prefers-reduced-motion: reduce) {
      article :global(.mchart-thumb) { transition: none; }
    }
    article :global(.mchart-modes button) {
      position: relative; z-index: 1; font: inherit; font-size: 0.8rem;
      color: #8a8f99; cursor: pointer; background: none; border: 0;
      border-radius: 999px; padding: 0.2rem 0.55rem;
      transition: color 0.25s ease;
    }
    article :global(.mchart-modes button:hover) { color: #b5bac3; }
    article :global(.mchart-modes button[aria-pressed="true"]) { color: #dde1e7; }
    article :global(.mchart-modes button:focus-visible) {
      outline: 2px solid #6AAEEE; outline-offset: 2px;
    }
    /* The site's own three: accent blue for the method that won, the warm
       accent for every neural arm, and the muted grey the page already uses
       for secondary text on the two controls. Blue against warm also keeps
       the two series apart under red-green colour blindness, which blue
       against orange did less well. */
    article :global(.mchart-lex) { background: #6aaeee; }
    article :global(.mchart-emb) { background: #e8b775; }
    article :global(.mchart-ctl) { background: #8a8f99; }
    /* 560, not 480: kept from the two-number layout. The rows are back to one
       number, but the axis labels and the button row both read better stacked
       before the bars get narrow. */
    @media (max-width: 560px) {
      article :global(.mchart) { grid-template-columns: 1fr max-content; column-gap: 0.5rem; }
      article :global(.mchart-row) { row-gap: 0.35rem; }
      article :global(.mchart-tipbox) { grid-column: 1 / 2; grid-row: 2 / 3; }
      /* The scale row carries one empty cell per column it has to skip, so it
         sheds one when the grid drops to two columns - otherwise its third
         child wraps onto a line of its own and the axis sits under the bars. */
      /* Two centred lines rather than two columns: neither has room to sit
         on its own alignment line at this width. */
      article :global(.mchart-head) { grid-template-columns: 1fr; }
      article :global(.mchart-head .mchart-key),
      article :global(.mchart-head:has(.mchart-modes[hidden]) .mchart-key),
      article :global(.mchart-modes) { grid-column: 1 / -1; justify-self: center; }
      article :global(.mchart-modes) { transform: none; margin-right: 0; }
      /* Both were pinned to row 1 for the wide layout, where they sit side by
         side. Stacked, that same pin puts them in one cell on top of each
         other, so the rows are split again here. */
      article :global(.mchart-modes) { grid-row: 1; }
      article :global(.mchart-head .mchart-key) { grid-row: 2; }
      article :global(.mchart-head .mchart-key) {
        flex-wrap: wrap; justify-content: center;
      }
      /* label moves above its own bar rather than squeezing a third column */
      article :global(.mchart-label) {
        grid-column: 1 / -1; text-align: left; margin-top: 0.4rem;
        white-space: normal;
      }
    }
    /* The vocabulary figure, in markup for the reasons .mchart gives above. It
       was a 720px SVG with its line breaks baked in, which a 327px phone scaled
       to a few pixels of text; here the words are real text that reflows, can be
       selected and searched, and is read aloud in order, and re-measuring a
       count is an edit rather than regenerating a file.

       Deliberately not a <pre>: the body is a wrapping paragraph and pre would
       send it sideways on a phone instead. Monospace without pre keeps the one
       thing the typeface is here to say, which is that the exact strings are
       the point. */
    article :global(.vocab) { margin: 1.5rem 0; }
    article :global(.vocab-issue) {
      background: #15181d;
      border-radius: 6px;
      padding: 1rem 1.1rem 0.85rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.85rem;
      line-height: 1.75;
    }
    article :global(.vocab-title) { font-size: 0.92rem; margin-bottom: 0.7rem; }
    /* Three inks, counted across this forge rather than across English. The
       rarest are the identifiers, which is the whole claim the figure is
       making. */
    article :global(.v-rare) { color: #6aaeee; font-weight: 600; }
    article :global(.v-mid) { color: #b5bac3; }
    article :global(.v-common) { color: #6b7681; }
    /* Swatches rather than the labels in their own ink: the common band is a
       dim grey that is readable as one word inside a sentence and tiring as a
       label, and the swatch keeps all three labels the same legible colour. */
    article :global(.vocab-key) {
      display: flex; flex-wrap: wrap; gap: 0.3rem 1rem;
      /* Centred like .mchart-key, so the key reads as belonging to the figure
         rather than to the left edge of the card above it. */
      justify-content: center;
      margin-top: 0.9rem; padding-top: 0.75rem;
      border-top: 1px solid #23272e;
      font-family: 'Piazzolla', serif; font-size: 0.8rem; color: #8a8f99;
    }
    article :global(.vocab-key span) { display: inline-flex; align-items: center; gap: 0.4rem; }
    article :global(.vocab-sw) { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
    article :global(.sw-rare) { background: #6aaeee; }
    article :global(.sw-mid) { background: #b5bac3; }
    article :global(.sw-common) { background: #6b7681; }
    /* Below the figure and muted, the way the chart's caption sits, rather than
       welded to the card the way .img-caption is to an image. */
    article :global(.vocab-cap) {
      color: #8a8f99; font-size: 0.85rem; margin-top: 0.7rem; line-height: 1.5;
      text-align: center;
    }
    article :global(hr) { border: none; border-top: 1px solid #2a2f37; margin: 2rem 0; }
    article :global(.article-gallery) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      margin: 1.25rem 0;
    }
    article :global(.gallery-thumb) {
      padding: 0;
      border: 1px solid #2a2f37;
      background: #2a2f37;
      border-radius: 4px;
      overflow: hidden;
      cursor: pointer;
      aspect-ratio: 16 / 9;
      transition: border-color 0.2s;
    }
    article :global(.gallery-thumb:hover img),
    article :global(.gallery-thumb:focus-visible img) {
      transform: scale(1.04);
    }
    article :global(.gallery-thumb:hover),
    article :global(.gallery-thumb:focus-visible) {
      border-color: #6AAEEE;
      outline: none;
    }
    article :global(.gallery-thumb img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      margin: 0;
      border-radius: 0;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    @media (max-width: 480px) {
      article :global(.article-gallery) {
        grid-template-columns: 1fr;
      }
    }
    :global(.gallery-lightbox) {
      position: fixed;
      inset: 0;
      background: rgba(15, 17, 21, 0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 200;
      padding: 2rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.22s ease, visibility 0s linear 0.22s;
    }
    :global(.gallery-lightbox.open) {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    @media (prefers-reduced-motion: reduce) {
      article :global(.gallery-thumb img),
      :global(.gallery-lightbox) { transition: none; }
      article :global(.gallery-thumb:hover img),
      article :global(.gallery-thumb:focus-visible img) { transform: none; }
    }
    :global(.gallery-lightbox img) {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 6px;
    }
    :global(.gallery-lightbox .close) {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: transparent;
      border: none;
      color: #ccc;
      font-size: 2rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.25rem 0.6rem;
    }
    :global(.gallery-lightbox .close:hover) { color: #fff; }
    .to-top {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      display: inline-flex;
      transform: translateX(-50%) translateY(0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .to-top.visible {
      opacity: 0.75;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .to-top:hover { opacity: 1; color: #fff; }
  </style>

  <a class="back-home" href="/projects" aria-label="Back to projects"><ArrowLeft size={28} stroke-width={1.5} /></a>
  <main id="main">
    {project.data.cover && (
      <button class="cover-btn" type="button" data-full={cloudinaryUrl(project.data.cover, { width: 1600 })}>
        <img
          class="cover"
          src={cloudinaryUrl(project.data.cover, { width: 1200 })}
          srcset={`${cloudinaryUrl(project.data.cover, { width: 800 })} 800w, ${cloudinaryUrl(project.data.cover, { width: 1200 })} 1200w, ${cloudinaryUrl(project.data.cover, { width: 1600 })} 1600w`}
          sizes="(max-width: 720px) 100vw, 720px"
          alt={project.data.coverAlt ?? ''}
        />
      </button>
    )}
    <h1>{project.data.title}</h1>
    <div class="meta">
      {project.data.wip ? (
        <span class="meta-live" tabindex={0}>{fmt(project.data.updated ?? project.data.date)}<span class="meta-wip" role="tooltip">work in progress</span></span>
      ) : project.data.updated ? (
        <>
          {fmt(project.data.date)}
          <span class="meta-upd">updated {fmt(project.data.updated)}</span>
        </>
      ) : (
        fmt(project.data.date)
      )}
    </div>
    <article>
      <Content />
    </article>
  </main>
  <a class="to-top" href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});this.classList.remove('visible');return false;" aria-label="To top"><ArrowUp size={28} stroke-width={1.5} /></a>
  <script>
    const backHome = document.querySelector('.back-home')!;
    const scrollTop = document.querySelector('.to-top')!;

    // The article pages exist only on polybjorn.com, so the arrow has to say
    // /projects in the HTML - one file serves every reader. Someone who came
    // from polybjorn.no is sent back there instead: on a static page the
    // referrer is the only thing that says which site they were on, and a
    // cross-origin navigation still carries the origin under the default
    // referrer policy. An absent referrer - a bookmark, a search result, a
    // browser that strips it - leaves the English link, which is the right
    // answer for a reader who did not come from the Norwegian site. The origin
    // is compared rather than matched as a prefix, so a lookalike host does not
    // get to aim this link.
    if (document.referrer && new URL(document.referrer).origin === 'https://polybjorn.no') {
      backHome.setAttribute('href', 'https://polybjorn.no/prosjekter');
    }
    window.addEventListener('scroll', () => {
      backHome.classList.toggle('hidden', window.scrollY > 60);
      scrollTop.classList.toggle('visible', window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 20);
    }, { passive: true });

    // The methods chart holds two measures per row - how often a method finds
    // the issue, and how long it takes - and a bar can only carry one at a
    // time, so a two-segment switch over the chart picks which. The rows sort
    // by whatever it picks, so the order always matches the measure on screen.
    // The control ships hidden and is revealed here: without this script the
    // chart is what it always was, recall in its written order.
    // #speed in the URL opens on the other measure, so a link can point at it.
    const mchart = document.querySelector<HTMLElement>('.mchart');
    const mview = mchart?.querySelector<HTMLElement>('.mchart-modes');
    if (mchart && mview) {
      const options = Array.from(mview.querySelectorAll<HTMLButtonElement>('button'));
      const rows = Array.from(mchart.querySelectorAll<HTMLElement>('.mchart-row[data-recall]'));
      // Only what actually differs between the views fades. A group heading
      // says the same thing in both, and the caption and the key never change
      // at all, so fading them just made the whole chart blink. The one
      // exception is the controls' own heading, which leaves with its rows.
      // Rows are sorted inside their own group, never across: the groups are
      // the chart's argument - counting words, a model, a second pass over
      // the first - and one flat list would trade that for a glance. The
      // heading is read off the markup rather than repeated on 27 rows, and a
      // group's anchor is whatever follows its last row, which never moves.
      type Group = { heading: HTMLElement; rows: HTMLElement[]; anchor: Node | null };
      const groups: Group[] = [];
      let current: Group | null = null;
      for (const child of Array.from(mchart.children) as HTMLElement[]) {
        if (child.classList.contains('mchart-group')) {
          current = { heading: child, rows: [], anchor: null };
          groups.push(current);
        } else if (current && child.classList.contains('mchart-row') && child.dataset.recall) {
          current.rows.push(child);
          current.anchor = child.nextSibling;
        }
      }
      const leaving = groups
        .filter(group => group.rows.every(row => !row.dataset.secs))
        .map(group => group.heading);
      const table = [...rows, ...leaving];

      // 0.1s at the left of a bar, 1h at the right: a decade scale, because
      // the fastest method here is four orders off the slowest and a linear
      // bar would leave sixteen rows invisible.
      const LOW = Math.log10(0.1);
      const SPAN = Math.log10(3600) - LOW;
      const say = (t: number) => t < 1 ? t.toFixed(1) + ' s'
        : t < 60 ? Math.round(t) + ' s'
        : t < 3600 ? Math.round(t / 60) + ' min' : (t / 3600).toFixed(1) + ' h';

      // Every bar changes length, the rows change order, and two of them
      // leave: animating all of that at once was the mess. The table fades
      // out instead, changes while nobody is looking, and fades back - so the
      // reader sees two clean states rather than the journey between them.
      // The switch itself keeps its slide; it is what was just pressed.
      let crossing: Animation[] = [];
      const cross = (rebuild: () => void, settle: boolean) => {
        const still = settle
          || window.matchMedia('(prefers-reduced-motion: reduce)').matches
          || typeof mchart.animate !== 'function';
        if (still) {
          rebuild();
          return;
        }
        // A second press mid-fade cancels the first, or the table can be left
        // sitting at whatever opacity that one had reached.
        for (const running of crossing) running.cancel();
        crossing = table.map(part => part.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 170, easing: 'ease-in', fill: 'forwards' },
        ));
        Promise.all(crossing.map(one => one.finished)).then(() => {
          rebuild();
          for (const running of crossing) running.cancel();
          crossing = table.map(part => part.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: 240, easing: 'ease-out' },
          ));
        }).catch(() => { /* cancelled by the next press; it owns the state */ });
      };

      const paint = (mode: string, settle = false) => {
        mchart.dataset.mode = mode;
        for (const option of options) {
          option.setAttribute('aria-pressed', String(option.dataset.mode === mode));
        }
        cross(() => {
          for (const row of rows) {
            const bar = row.querySelector<HTMLElement>('.mchart-bar');
            const val = row.querySelector<HTMLElement>('.mchart-val');
            if (!bar || !val) continue;
            const secs = row.dataset.secs;
            // The two controls sort the list and stop: no index to build, so
            // no run time, and a row reading "-" is a row asking to be read
            // for nothing. They leave the speed view, heading and all.
            row.toggleAttribute('hidden', mode === 'speed' && !secs);
            if (mode === 'speed') {
              if (!secs) continue;
              bar.style.width = ((Math.log10(Number(secs)) - LOW) / SPAN * 100).toFixed(1) + '%';
              val.textContent = say(Number(secs));
            } else {
              bar.style.width = row.dataset.recall + '%';
              val.textContent = row.dataset.recall + '%';
            }
          }
          for (const group of groups) {
            group.heading.toggleAttribute('hidden',
              mode === 'speed' && group.rows.every(row => !row.dataset.secs));
            const sorted = group.rows.slice();
            sorted.sort(mode === 'speed'
              ? (one, two) => Number(one.dataset.secs ?? Infinity) - Number(two.dataset.secs ?? Infinity)
              : (one, two) => Number(two.dataset.recall) - Number(one.dataset.recall));
            for (const row of sorted) mchart.insertBefore(row, group.anchor);
          }
        }, settle);
      };

      for (const option of options) {
        option.addEventListener('click', () => paint(option.dataset.mode ?? 'recall'));
      }
      mview.removeAttribute('hidden');
      paint(location.hash === '#speed' ? 'speed' : 'recall', true);
    }

    const thumbs = document.querySelectorAll('.cover-btn, .gallery-thumb, .img-zoom');
    if (thumbs.length) {
      const items = Array.from(thumbs as NodeListOf<HTMLElement>).map(t => ({
        src: t.dataset.full ?? '',
        alt: t.querySelector('img')?.alt ?? '',
      }));
      let idx = 0;
      // Bumped by every navigation and by close, so an image that finishes
      // loading after the viewer moved on does not overwrite the newer one.
      let seq = 0;
      let lastWheel = 0;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';

      const lightbox = document.createElement('div');
      lightbox.className = 'gallery-lightbox';
      lightbox.innerHTML = '<button class="close" type="button" aria-label="Close">×</button><img alt="" />';
      document.body.appendChild(lightbox);
      const lbImg = lightbox.querySelector('img')!;
      lbImg.style.cursor = 'pointer';

      const preload = (src: string) => {
        const im = new Image();
        im.src = src;
        return im.decode().catch(() => {});
      };
      const setImg = () => {
        lbImg.src = items[idx].src;
        lbImg.alt = items[idx].alt;
      };
      // dir: -1/1 slides between images; from: the clicked thumbnail, which
      // the opening image grows out of.
      const show = async (i: number, dir = 0, from?: HTMLElement) => {
        idx = (i + items.length) % items.length;
        const mine = ++seq;
        const animate = !reduceMotion.matches;
        if (from) lbImg.style.visibility = 'hidden';
        await preload(items[idx].src);
        if (mine !== seq) return;
        if (dir && animate) {
          await lbImg.animate(
            [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-dir * 24}px)` }],
            { duration: 110, easing: 'ease-in' },
          ).finished.catch(() => {});
          if (mine !== seq) return;
          setImg();
          lbImg.animate(
            [{ opacity: 0, transform: `translateX(${dir * 24}px)` }, { opacity: 1, transform: 'none' }],
            { duration: 200, easing: EASE },
          );
          return;
        }
        setImg();
        lbImg.style.visibility = '';
        if (from && animate) {
          const f = from.getBoundingClientRect();
          const t = lbImg.getBoundingClientRect();
          if (!t.width) return;
          const dx = f.left + f.width / 2 - (t.left + t.width / 2);
          const dy = f.top + f.height / 2 - (t.top + t.height / 2);
          lbImg.animate(
            [{ opacity: 0.3, transform: `translate(${dx}px, ${dy}px) scale(${f.width / t.width})` }, { opacity: 1, transform: 'none' }],
            { duration: 320, easing: EASE },
          );
        }
      };
      const prev = () => show(idx - 1, -1);
      const next = () => show(idx + 1, 1);
      const isOpen = () => lightbox.classList.contains('open');
      const closeLb = () => {
        seq++;
        lightbox.classList.remove('open');
        if (!reduceMotion.matches) {
          lbImg.animate([{ transform: 'none' }, { transform: 'scale(0.96)' }], { duration: 220, easing: 'ease-in' });
        }
      };

      lightbox.querySelector('.close')!.addEventListener('click', closeLb);
      lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLb(); });
      lbImg.addEventListener('click', e => {
        e.stopPropagation();
        const rect = lbImg.getBoundingClientRect();
        if (e.clientX < rect.left + rect.width / 2) prev();
        else next();
      });
      lightbox.addEventListener('wheel', e => {
        if (!isOpen()) return;
        e.preventDefault();
        // A trackpad swipe fires a stream of wheel events; only the first one
        // after a pause turns the page, so one gesture moves one image.
        const quiet = e.timeStamp - lastWheel > 150;
        lastWheel = e.timeStamp;
        if (!quiet) return;
        if (e.deltaY > 0) next();
        else prev();
      }, { passive: false });
      lightbox.addEventListener('mouseup', e => {
        if (e.button === 3) { e.preventDefault(); prev(); }
        else if (e.button === 4) { e.preventDefault(); next(); }
      });
      document.addEventListener('keydown', e => {
        if (!isOpen()) return;
        if (e.key === 'Escape') closeLb();
        else if (e.key === 'ArrowLeft') prev();
        else if (e.key === 'ArrowRight') next();
      });

      thumbs.forEach((btn, i) => {
        btn.addEventListener('click', () => {
          lightbox.classList.add('open');
          show(i, 0, btn as HTMLElement);
        });
      });
    }
  </script>
</Layout>
