---
// One row of the intake form. All four stages render their fields through
// this, so a change to the label/optional-tag/help pattern lands everywhere
// at once - the three stages used to carry near-identical copies of this
// markup and had already started to drift (the checkbox group hardcoded its
// "(optional)" tag instead of deriving it).
interface Props {
  field: any;
  lang: 'en' | 'no';
  td: any;
}

const { field, lang, td } = Astro.props;

// An option list is either plain ({ value, en, no }) or annotated with an
// example ({ value, label, example }) - ORDER_TYPES and materialProperties
// use the second shape.
const optionLabel = (opt: any) => (opt.label ? opt.label[lang] : opt[lang]);

// A field offers either one example or a set of them. The set renders its first
// entry and the script swaps in one of the others per visit, so the markup is
// never without an example and never depends on script for one.
// A question can name a subset of its options - the specialised ones, which are
// the same markup in a group of their own beside the rest. See .option-groups.
const options = field.options ?? [];
const coreOptions = options.filter((opt: any) => !opt.advanced);
const advancedOptions = options.filter((opt: any) => opt.advanced);

const placeholder = field.placeholder
  ? field.placeholder[lang]
  : field.placeholders
    ? field.placeholders[lang][0]
    : undefined;
---

<div class="field" data-field={field.id}>
  {field.type === 'radio' || field.type === 'checkboxGroup' ? (
    <fieldset>
      <legend class="field-label">{field.label[lang]}{field.required && (
        <span class="required-mark" aria-hidden="true"></span>
      )}</legend>
      <div class:list={['option-groups', !advancedOptions.length && 'option-groups-single']}>
        <div
          class:list={[
            'option-list',
            field.inlineOptions && 'option-list-inline',
          ]}
        >
          {coreOptions.map((opt: any) => (
            <label>
              <input
                type={field.type === 'radio' ? 'radio' : 'checkbox'}
                name={field.type === 'radio' ? field.id : `${field.id}[]`}
                value={opt.value}
                required={field.type === 'radio' ? field.required : undefined}
              />
              {opt.example ? (
                <span class="option-text">
                  <span class="option-label">{optionLabel(opt)}{opt.qualifier && (
                    <span class="option-qualifier">{opt.qualifier[lang]}</span>
                  )}</span>
                  <span class="option-example">{opt.example[lang]}</span>
                </span>
              ) : (
                <span class="option-label">{optionLabel(opt)}{opt.qualifier && (
                    <span class="option-qualifier">{opt.qualifier[lang]}</span>
                  )}</span>
              )}
            </label>
          ))}
        </div>

        {/*
          A nested fieldset, because these are a named subset of the same
          question: the name has to reach a screen reader as the label of a
          group, not as a paragraph that happens to sit above some checkboxes.
          It is named with aria-label rather than a <legend> because the visible
          copy has to disappear once the group stands in its own column, and
          hiding a legend means positioning it - which engines do not reliably
          honour, and a legend that ignores it lands as 1.2rem bold white from
          the generic rule: the loudest thing in the question it was supposed to
          disappear from.

          So the visible copy is a paragraph, aria-hidden so the name is not
          read twice, and display: none on it is a promise the browser keeps.
        */}
        {advancedOptions.length > 0 && (
          <fieldset class="option-group" aria-label={field.advancedLabel[lang]}>
            <p class="option-group-label" aria-hidden="true">{field.advancedLabel[lang]}</p>
            <div class="option-list">
              {advancedOptions.map((opt: any) => (
                <label>
                  <input
                    type={field.type === 'radio' ? 'radio' : 'checkbox'}
                    name={field.type === 'radio' ? field.id : `${field.id}[]`}
                    value={opt.value}
                    required={field.type === 'radio' ? field.required : undefined}
                  />
                  {opt.example ? (
                    <span class="option-text">
                      <span class="option-label">{optionLabel(opt)}{opt.qualifier && (
                    <span class="option-qualifier">{opt.qualifier[lang]}</span>
                  )}</span>
                      <span class="option-example">{opt.example[lang]}</span>
                    </span>
                  ) : (
                    <span class="option-label">{optionLabel(opt)}{opt.qualifier && (
                    <span class="option-qualifier">{opt.qualifier[lang]}</span>
                  )}</span>
                  )}
                </label>
              ))}
            </div>
          </fieldset>
        )}
      </div>
    </fieldset>
  ) : field.type === 'checkbox' ? (
    /*
      A lone checkbox labels itself, beside the box - not with a heading above
      it like every other control here. It reuses .option-list so it lines up
      with the radio and checkbox groups elsewhere in the form.
    */
    <div class="option-list">
      <label>
        <input type="checkbox" id={field.id} name={field.id} value="yes" />
        <span class="option-label">{field.label[lang]}</span>
      </label>
    </div>
  ) : (
    <>
      <label class="field-label" id={`${field.id}-label`} for={field.id}>{field.label[lang]}{field.required && (
        <span class="required-mark" aria-hidden="true"></span>
      )}</label>

      {field.type === 'textarea' && (
        <textarea
          id={field.id}
          name={field.id}
          required={field.required}
          placeholder={placeholder}
        ></textarea>
      )}

      {field.type === 'select' && (
        /*
          Three things, and only two of them are ever on screen at once.

          The <select> is the form: it carries the value, it is what FormData
          reads, and without script it is the whole control - which is why it is
          rendered plainly and hidden by the script rather than the other way
          round. A visitor with no JavaScript gets the native dropdown exactly as
          before.

          The button and the list are what the script swaps in. They exist in the
          markup rather than being built at runtime so they carry this
          component's scope: a node created by a script has no data-astro-cid and
          every scoped rule below would miss it.
        */
        <div class="select-wrap">
          <select id={field.id} name={field.id} required={field.required}>
            <option value="" disabled selected>{td.choosePlaceholder}</option>
            {field.options.map((opt: any) => (
              <option value={opt.value}>{optionLabel(opt)}</option>
            ))}
          </select>

          <button
            type="button"
            class="combo-button"
            id={`${field.id}-button`}
            role="combobox"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`${field.id}-listbox`}
            aria-labelledby={`${field.id}-label ${field.id}-button`}
            hidden
          >
            <span class="combo-value">{td.choosePlaceholder}</span>
          </button>

          <ul
            class="combo-list"
            id={`${field.id}-listbox`}
            role="listbox"
            aria-labelledby={`${field.id}-label`}
            hidden
          >
            {field.options.map((opt: any, i: number) => (
              <li
                class="combo-option"
                id={`${field.id}-option-${i}`}
                role="option"
                aria-selected="false"
                data-value={opt.value}
              >{optionLabel(opt)}</li>
            ))}
          </ul>
        </div>
      )}

      {field.type === 'file' && (
        <>
          <!--
            The input stays real and focusable (visually hidden, not
            `hidden`) so the native file picker and keyboard use still work -
            "Browse"/"Choose File" is the browser's own UI language, not
            ours, so a styled label is the only way to get Norwegian text on
            the trigger itself.
          -->
          <input
            type="file"
            id={field.id}
            name={field.id}
            accept={field.accept}
            multiple={field.multiple}
            class="file-input-visually-hidden"
          />
          <div class="file-pick">
            <label for={field.id} class="file-trigger" id={`${field.id}-trigger`}>{td.chooseFilesLabel}</label>
            {field.help && <p class="field-help file-help">{field.help[lang]}</p>}
          </div>
          <ul class="file-list" id={`${field.id}-list`} hidden></ul>
          <!--
            Only shown if the browser cannot rebuild a FileList, in which case
            adding and removing are not on offer and the native
            replace-the-lot behaviour is all there is.
          -->
          <p class="field-help" id={`${field.id}-fallback`} hidden>{td.fileReplaceNote}</p>
        </>
      )}

      {field.type === 'text' && (
        <div class="input-with-note">
          <input
            type={field.inputType || 'text'}
            id={field.id}
            name={field.id}
            required={field.required}
            autocomplete={field.autocomplete}
            placeholder={placeholder}
            pattern={field.pattern}
            aria-describedby={field.boxNote ? `${field.id}-note` : undefined}
          />
          {/*
            A standing note inside the box, on the right. Not aria-hidden and
            not a placeholder: it is part of the answer the field is asking for,
            and a placeholder would take it away at the first keystroke - which
            is the moment it starts mattering.
          */}
          {field.boxNote && (
            <span class="input-note" id={`${field.id}-note`}>{field.boxNote[lang]}</span>
          )}
        </div>
      )}
    </>
  )}
  {field.help && field.type !== 'file' && <p class="field-help">{field.help[lang]}</p>}
  <!--
    Filled in by IntakeForm.astro when a submit is refused. Every field has one,
    so nothing has to be created at the point of failure - and being rendered
    here it carries this component's scope, which a script-created node would
    not.
  -->
  <p class="field-error" id={`${field.id}-error`} hidden></p>
</div>

<style>
  /* These rules live here, not in IntakeForm.astro, because Astro scopes a
     style block to the component that declares it: a selector written in the
     parent gets a data-astro-cid that the elements rendered here never carry,
     so it silently matches nothing and every field renders unstyled. The
     fieldset and legend resets are duplicated in both files for the same
     reason - each component has its own. */
      /* No bottom margin of its own: the gap after a question belongs to the
         field, not to the options inside it. With it here, a validation mark -
         which is rendered after the fieldset, at the end of the field - was
         pushed 2.5rem clear of the answers it was talking about. The field
         below carries that gap now, so the mark sits under the options and the
         spacing between questions is unchanged. */
      fieldset {
        border: none;
        padding: 0;
        margin: 0;
      }

      .field:has(fieldset) {
        margin-bottom: 2.5rem;
      }

      legend, .section-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 1.2rem;
        padding: 0;
      }

      .field {
        margin-bottom: 1.4rem;
      }

      /* The width a group heading asks about (see the @container rule at the
         bottom). On the field rather than on the fieldset inside it, because the
         nested group is a fieldset too and a container there would have the
         heading asking about the width of its own column, which is never wide.

         Only on the field that has such a group, though. inline-size containment
         means an element sizes itself without looking at its contents, which is
         exactly wrong for a field that has to tell a flex row how wide its label
         is: as a flex item it collapsed to min-content and wrapped one word per
         line. Two things were on every field that only one field needed. */
      .field:has(.option-group) {
        container-type: inline-size;
      }

      /* flex so the required dot beside the text is centred against the text's
         own line, rather than against vertical-align's guess at where the middle
         of a line is - that put it a shade low, which on a 5px dot is the
         difference between beside the label and under it.

         Wrapping allowed, so a long label and its dot behave like a line of
         text: the dot follows the last word onto whichever line it ends on. */
      .field label.field-label,
      .field legend.field-label {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        font-size: 0.98rem;
        color: #dde1e7;
        margin-bottom: 0.4rem;
        font-weight: 600;
      }

      /* A grouped question needs its legend to read as clearly above its
         options, which share the same weight and colour as the legend - so the
         hierarchy comes from size here instead, not from dimming the options. */
      .field fieldset legend.field-label {
        font-size: 1.1rem;
        margin-bottom: 0.7rem;
      }

      /* Required, said in one mark. aria-hidden because the control already
         carries required and a screen reader says so itself - this is for eyes
         only, and it is the same amber the field turns if it is skipped: a
         promise of what happens, in the colour it happens in.

         A drawn dot rather than an asterisk. In a serif face the asterisk is cut
         high on the line, the way a footnote marker is meant to be, so beside a
         label it hung above the text and read as a stray character. A dot has no
         metrics of its own to fight: the box is 0.9rem so there is something to
         hover for the tooltip, and the dot inside it is centred by the flex
         rather than by a font's idea of where the glyph belongs. */
      /* The dot is centred inside its own box and the box is centred on the
         text, which is two separate jobs done two separate ways on purpose.

         The box relies on vertical-align rather than on its parent being a flex
         row. It was relying on the flex, and that works for the fields whose
         label is a <label> and not for the one whose label is a <legend>:
         browsers do not reliably honour display on a legend, so on "Hva har du
         så langt?" the box fell back to sitting on the baseline and the dot rode
         low. vertical-align: middle is honoured everywhere. */
      .required-mark {
        display: inline-block;
        position: relative;
        width: 0.9rem;
        height: 0.9rem;
        margin-left: 0.1rem;
        vertical-align: middle;
      }

      .required-mark::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 0.3rem;
        height: 0.3rem;
        border-radius: 50%;
        background: #e8b775;
      }

      /* Gone once the field is marked. The dot is a promise that this one will
         go amber if it is skipped; the amber box is that having happened. Both
         at once is the same warning twice, in the same colour, a centimetre
         apart - and the one that is still only a promise is the one to drop. */
      .field.is-missing .required-mark {
        display: none;
      }

      .field-error {
        font-size: 0.88rem;
        color: #e8b775;
        margin: 0.4rem 0 0;
        line-height: 1.4;
      }

      .field-help {
        font-size: 0.88rem;
        color: #888;
        margin: 0.3rem 0 0;
        line-height: 1.4;
      }

      input[type="text"],
      input[type="email"],
      input[type="tel"],
      textarea,
      select,
      .combo-button {
        width: 100%;
        background: #2a2e35;
        border: 1px solid #3a3f47;
        border-radius: 8px;
        color: #dde1e7;
        font-family: 'Piazzolla', serif;
        /* Not below 1rem: iOS Safari zooms the viewport when a control with a
           font under 16px takes focus, and each stage change focuses one. */
        font-size: 1rem;
        padding: 0.65rem 0.8rem;
        /* Stated, not inherited: a select works out its own line box from the
           font otherwise, and came out a couple of pixels taller than the text
           inputs it sits next to. */
        line-height: 1.35;
      }

      /* The box is ours, the arrow and the list were the platform's: a select
         left at its default draws its own control furniture, which is why it
         did not match the inputs above it. appearance: none hands the whole box
         over to the rules above, and the arrow below is drawn from a rotated
         corner rather than an image, so it takes its colour from the page like
         everything else.

         The popup list itself is the platform's and always will be - what makes
         it dark is color-scheme on the page (IntakeForm.astro), and these
         option colours are for the engines that take them instead. */
      select {
        appearance: none;
        -webkit-appearance: none;
        /* Room for the arrow, so a long answer does not run under it. */
        padding-right: 2.4rem;
        cursor: pointer;
      }

      option {
        background: #2a2e35;
        color: #dde1e7;
      }

      .select-wrap {
        position: relative;
      }

      /* The native control while the script is driving: out of the tab order
         and out of the accessibility tree, still in the form and still holding
         the value. Not [hidden] and not display: none - a control that is not
         rendered is one some browsers decline to submit. */
      .combo-native-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Everything the box rule above sets, plus what a button does not inherit
         from it: buttons centre their text and come with their own font.

         Then a shade lighter than a text input, which is the point: the box rule
         gives it the same border, radius and metrics as the field above it, and
         with the same background too it read as another box to type in rather
         than a thing that opens. Room on the right for the arrow, so a long
         answer stops before it rather than running under it. */
      .combo-button {
        display: flex;
        align-items: center;
        min-height: 2.7rem;
        padding-right: 2.4rem;
        background: #30353e;
        text-align: left;
        cursor: pointer;
      }

      .combo-button:hover {
        background: #363c46;
      }

      .combo-button[aria-expanded="true"] {
        border-color: #4a5058;
      }

      /* Placeholder until something is chosen: the same grey as a real
         placeholder, because that is what it is. */
      .combo-value {
        color: #7c848f;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .combo-value.has-value {
        color: #dde1e7;
      }

      /* The part a native select would not let us have. Over the page rather
         than in it, so opening one does not move the fields below. */
      .combo-list {
        position: absolute;
        top: calc(100% + 0.35rem);
        left: 0;
        right: 0;
        z-index: 50;
        /* Tall enough that neither of these lists scrolls - six budget brackets
           come to about 15rem, and five ownership answers to more than that
           because two of them wrap. The cap is there for a short window, not to
           ration the list: 65vh leaves the page visible behind it either way,
           and scrolling inside a dropdown to reach the last of six answers is a
           scroll nobody should have to find. */
        max-height: min(24rem, 65vh);
        overflow-y: auto;
        margin: 0;
        padding: 0.3rem;
        list-style: none;
        background: #2a2e35;
        border: 1px solid #4a5058;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      }

      .combo-option {
        padding: 0.5rem 0.6rem;
        border-radius: 6px;
        font-size: 1rem;
        color: #dde1e7;
        cursor: pointer;
      }

      /* One highlight, driven by the keyboard and by the pointer alike, so
         there is never a hover in one place and an arrow key in another. */
      .combo-option.is-active {
        background: #343a44;
      }

      .combo-option[aria-selected="true"] {
        color: #6aaeee;
      }

      .combo-button:focus-visible {
        outline: 2px solid #6aaeee;
        outline-offset: 2px;
      }

      .field.is-missing .combo-button {
        border-color: #a8764a;
      }

      .select-wrap::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 1rem;
        width: 0.5rem;
        height: 0.5rem;
        border-right: 2px solid #aab1ba;
        border-bottom: 2px solid #aab1ba;
        transform: translateY(-70%) rotate(45deg);
        pointer-events: none;
      }

      .select-wrap:hover::after {
        border-color: #fff;
      }

      /* Pointing up while the list is open, because the list is above nothing:
         it says "this closes" rather than "this opens" once it already has. */
      .select-wrap:has(.combo-button[aria-expanded="true"])::after {
        transform: translateY(-30%) rotate(225deg);
      }

      textarea {
        min-height: 6rem;
        resize: vertical;
      }

      /* Reads as an example, not as an answer someone has already given. */
      ::placeholder {
        color: #7c848f;
        opacity: 1;
      }

      .input-with-note {
        position: relative;
      }

      /* Same grey as a placeholder, because it is the same kind of thing: not
         typed, not clickable, and it must not look like a value. */
      .input-note {
        position: absolute;
        top: 50%;
        right: 0.8rem;
        transform: translateY(-50%);
        font-size: 0.82rem;
        color: #7c848f;
        pointer-events: none;
      }

      /* Room for it, so a long answer runs under the note rather than into it.
         Only where there is a note to make room for. */
      .input-with-note:has(.input-note) input {
        padding-right: 5rem;
      }

      /* Real input, not `hidden` - stays keyboard-focusable so Enter/Space
         still opens the native picker. The visible trigger is the <label>
         below; its focus ring is driven off this input's :focus-visible via
         the sibling selector further down. */
      .file-input-visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .file-pick {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }

      .file-help {
        margin: 0;
        flex: 1;
      }

      /* Beside a button there is not much width left, and this help is two
         sentences - below about 600px it goes back under the button. */
      @media (max-width: 600px) {
        .file-pick {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
      }

      .file-trigger {
        display: inline-block;
        flex-shrink: 0;
        font-family: 'Piazzolla', serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: #1e2228;
        background: #6aaeee;
        border-radius: 6px;
        padding: 0.55rem 1rem;
        cursor: pointer;
      }

      .file-trigger:hover {
        background: #85bcf2;
      }

      .file-input-visually-hidden:focus-visible + .file-trigger {
        outline: 2px solid #6aaeee;
        outline-offset: 2px;
      }

      .file-list {
        list-style: none;
        margin: 0.6rem 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      /* The rows are built by the script, so they never carry this
         component's data-astro-cid and a plain scoped selector would match
         nothing - the same trap that shipped the whole form unstyled once
         already. Anchoring on the scoped .file-list and marking the
         descendants :global() is what makes these apply. */
      .file-list :global(.file-row) {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.88rem;
        color: #aab1ba;
        background: #23272e;
        border: 1px solid #333840;
        border-radius: 6px;
        padding: 0.4rem 0.5rem 0.4rem 0.7rem;
      }

      .file-list :global(.file-name) {
        flex: 1;
        overflow-wrap: anywhere;
      }

      .file-list :global(.file-size) {
        flex-shrink: 0;
        color: #7c848f;
        font-variant-numeric: tabular-nums;
      }

      .file-list :global(.file-row-over) {
        border-color: #7a5a30;
        color: #e8b775;
      }

      .file-list :global(.file-row-over .file-size) {
        color: #e8b775;
      }

      .file-list :global(.file-remove) {
        flex-shrink: 0;
        background: transparent;
        border: 1px solid #3a3f47;
        border-radius: 5px;
        color: #aab1ba;
        font-family: 'Piazzolla', serif;
        font-size: 1rem;
        line-height: 1;
        padding: 0.15rem 0.45rem 0.25rem;
        cursor: pointer;
      }

      .file-list :global(.file-remove:hover) {
        border-color: #e8b775;
        color: #e8b775;
      }

      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
        outline: 2px solid #6aaeee;
        outline-offset: 2px;
      }

      /* A field the submit refused. The box itself is marked, where the eye
         already is: the list by the Send button names every missing answer in
         words, so a sentence under each field as well made a refused submit
         into a page of warnings. A question with no box of its own - a radio
         or checkbox group - marks its legend instead.

         The focus ring takes the same colour. A blue ring around a marked box
         reads as two states at once, which is what made the refused form look
         like it had two things wrong with every field. */
      .field.is-missing input[type="text"],
      .field.is-missing input[type="email"],
