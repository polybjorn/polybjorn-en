---
// One row of the intake form. All four stages render their fields through
// this, so a change to the label/optional-tag/help pattern lands everywhere
// at once - the three stages used to carry near-identical copies of this
// markup and had already started to drift (the checkbox group hardcoded its
// "(optional)" tag instead of deriving it).
interface Props {
  field: any;
  lang: 'en' | 'no';
  td: any;
}

const { field, lang, td } = Astro.props;

// An option list is either plain ({ value, en, no }) or annotated with an
// example ({ value, label, example }) - ORDER_TYPES and materialProperties
// use the second shape.
const optionLabel = (opt: any) => (opt.label ? opt.label[lang] : opt[lang]);
---

<div class="field" data-field={field.id}>
  {field.type === 'radio' || field.type === 'checkboxGroup' ? (
    <fieldset>
      <legend class="field-label">{field.label[lang]}</legend>
      <div class:list={['option-list', field.inlineOptions && 'option-list-inline']}>
        {field.options.map((opt: any) => (
          <label>
            <input
              type={field.type === 'radio' ? 'radio' : 'checkbox'}
              name={field.type === 'radio' ? field.id : `${field.id}[]`}
              value={opt.value}
              required={field.type === 'radio' ? field.required : undefined}
            />
            {opt.example ? (
              <span class="option-text">
                <span class="option-label">{optionLabel(opt)}</span>
                <span class="option-example">{opt.example[lang]}</span>
              </span>
            ) : (
              <span class="option-label">{optionLabel(opt)}</span>
            )}
          </label>
        ))}
      </div>
    </fieldset>
  ) : field.type === 'checkbox' ? (
    /*
      A lone checkbox labels itself, beside the box - not with a heading above
      it like every other control here. It reuses .option-list so it lines up
      with the radio and checkbox groups elsewhere in the form.
    */
    <div class="option-list">
      <label>
        <input type="checkbox" id={field.id} name={field.id} value="yes" />
        <span class="option-label">{field.label[lang]}</span>
      </label>
    </div>
  ) : (
    <>
      <label class="field-label" for={field.id}>{field.label[lang]}</label>

      {field.type === 'textarea' && (
        <textarea id={field.id} name={field.id} required={field.required}></textarea>
      )}

      {field.type === 'select' && (
        <select id={field.id} name={field.id} required={field.required}>
          <option value="" disabled selected>{td.choosePlaceholder}</option>
          {field.options.map((opt: any) => (
            <option value={opt.value}>{optionLabel(opt)}</option>
          ))}
        </select>
      )}

      {field.type === 'file' && (
        <>
          <!--
            The input stays real and focusable (visually hidden, not
            `hidden`) so the native file picker and keyboard use still work -
            "Browse"/"Choose File" is the browser's own UI language, not
            ours, so a styled label is the only way to get Norwegian text on
            the trigger itself.
          -->
          <input
            type="file"
            id={field.id}
            name={field.id}
            accept={field.accept}
            multiple={field.multiple}
            class="file-input-visually-hidden"
          />
          <div class="file-pick">
            <label for={field.id} class="file-trigger" id={`${field.id}-trigger`}>{td.chooseFilesLabel}</label>
            {field.help && <p class="field-help file-help">{field.help[lang]}</p>}
          </div>
          <ul class="file-list" id={`${field.id}-list`} hidden></ul>
          <!--
            Only shown if the browser cannot rebuild a FileList, in which case
            adding and removing are not on offer and the native
            replace-the-lot behaviour is all there is.
          -->
          <p class="field-help" id={`${field.id}-fallback`} hidden>{td.fileReplaceNote}</p>
        </>
      )}

      {field.type === 'text' && (
        <input
          type={field.inputType || 'text'}
          id={field.id}
          name={field.id}
          required={field.required}
          autocomplete={field.autocomplete}
        />
      )}
    </>
  )}
  {field.help && field.type !== 'file' && <p class="field-help">{field.help[lang]}</p>}
  <!--
    Filled in by IntakeForm.astro when a submit is refused. Every field has one,
    so nothing has to be created at the point of failure - and being rendered
    here it carries this component's scope, which a script-created node would
    not.
  -->
  <p class="field-error" id={`${field.id}-error`} hidden></p>
</div>

<style>
  /* These rules live here, not in IntakeForm.astro, because Astro scopes a
     style block to the component that declares it: a selector written in the
     parent gets a data-astro-cid that the elements rendered here never carry,
     so it silently matches nothing and every field renders unstyled. The
     fieldset and legend resets are duplicated in both files for the same
     reason - each component has its own. */
      /* No bottom margin of its own: the gap after a question belongs to the
         field, not to the options inside it. With it here, a validation mark -
         which is rendered after the fieldset, at the end of the field - was
         pushed 2.5rem clear of the answers it was talking about. The field
         below carries that gap now, so the mark sits under the options and the
         spacing between questions is unchanged. */
      fieldset {
        border: none;
        padding: 0;
        margin: 0;
      }

      .field:has(fieldset) {
        margin-bottom: 2.5rem;
      }

      legend, .section-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 1.2rem;
        padding: 0;
      }

      .field {
        margin-bottom: 1.4rem;
      }

      .field label.field-label,
      .field legend.field-label {
        display: block;
        font-size: 0.98rem;
        color: #dde1e7;
        margin-bottom: 0.4rem;
        font-weight: 600;
      }

      /* A grouped question needs its legend to read as clearly above its
         options, which share the same weight and colour as the legend - so the
         hierarchy comes from size here instead, not from dimming the options. */
      .field fieldset legend.field-label {
        font-size: 1.1rem;
        margin-bottom: 0.7rem;
      }

      .field-error {
        font-size: 0.88rem;
        color: #e8b775;
        margin: 0.4rem 0 0;
        line-height: 1.4;
      }

      .field-help {
        font-size: 0.88rem;
        color: #888;
        margin: 0.3rem 0 0;
        line-height: 1.4;
      }

      input[type="text"],
      input[type="email"],
      input[type="tel"],
      textarea,
      select {
        width: 100%;
        background: #2a2e35;
        border: 1px solid #3a3f47;
        border-radius: 8px;
        color: #dde1e7;
        font-family: 'Piazzolla', serif;
        /* Not below 1rem: iOS Safari zooms the viewport when a control with a
           font under 16px takes focus, and each stage change focuses one. */
        font-size: 1rem;
        padding: 0.65rem 0.8rem;
      }

      textarea {
        min-height: 6rem;
        resize: vertical;
      }

      /* Real input, not `hidden` - stays keyboard-focusable so Enter/Space
         still opens the native picker. The visible trigger is the <label>
         below; its focus ring is driven off this input's :focus-visible via
         the sibling selector further down. */
      .file-input-visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .file-pick {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }

      .file-help {
        margin: 0;
        flex: 1;
      }

      /* Beside a button there is not much width left, and this help is two
         sentences - below about 600px it goes back under the button. */
      @media (max-width: 600px) {
        .file-pick {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
      }

      .file-trigger {
        display: inline-block;
        flex-shrink: 0;
        font-family: 'Piazzolla', serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: #1e2228;
        background: #6aaeee;
        border-radius: 6px;
        padding: 0.55rem 1rem;
        cursor: pointer;
      }

      .file-trigger:hover {
        background: #85bcf2;
      }

      .file-input-visually-hidden:focus-visible + .file-trigger {
        outline: 2px solid #6aaeee;
        outline-offset: 2px;
      }

      .file-list {
        list-style: none;
        margin: 0.6rem 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      /* The rows are built by the script, so they never carry this
         component's data-astro-cid and a plain scoped selector would match
         nothing - the same trap that shipped the whole form unstyled once
         already. Anchoring on the scoped .file-list and marking the
         descendants :global() is what makes these apply. */
      .file-list :global(.file-row) {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.88rem;
        color: #aab1ba;
        background: #23272e;
        border: 1px solid #333840;
        border-radius: 6px;
        padding: 0.4rem 0.5rem 0.4rem 0.7rem;
      }

      .file-list :global(.file-name) {
        flex: 1;
        overflow-wrap: anywhere;
      }

      .file-list :global(.file-size) {
        flex-shrink: 0;
        color: #7c848f;
        font-variant-numeric: tabular-nums;
      }

      .file-list :global(.file-row-over) {
        border-color: #7a5a30;
        color: #e8b775;
      }

      .file-list :global(.file-row-over .file-size) {
        color: #e8b775;
      }

      .file-list :global(.file-remove) {
        flex-shrink: 0;
        background: transparent;
        border: 1px solid #3a3f47;
        border-radius: 5px;
        color: #aab1ba;
        font-family: 'Piazzolla', serif;
        font-size: 1rem;
        line-height: 1;
        padding: 0.15rem 0.45rem 0.25rem;
        cursor: pointer;
      }

      .file-list :global(.file-remove:hover) {
        border-color: #e8b775;
        color: #e8b775;
      }

      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
        outline: 2px solid #6aaeee;
        outline-offset: 2px;
      }

      /* A field the submit refused. The box itself is marked, where the eye
         already is: the list by the Send button names every missing answer in
         words, so a sentence under each field as well made a refused submit
         into a page of warnings. A question with no box of its own - a radio
         or checkbox group - marks its legend instead.

         The focus ring takes the same colour. A blue ring around a marked box
         reads as two states at once, which is what made the refused form look
         like it had two things wrong with every field. */
      .field.is-missing input[type="text"],
      .field.is-missing input[type="email"],
      .field.is-missing input[type="tel"],
      .field.is-missing textarea,
      .field.is-missing select {
        border-color: #a8764a;
      }

      .field.is-missing legend.field-label {
        color: #e8b775;
      }

      /* One of a set of fields that between them answer a single rule - phone,
         Signal and e-post - while none of them is answered. Nothing standing
         here: any one of the three satisfies the rule, and three marked boxes
         read as three things that each have to be filled in. The ring is only
         marked once you are in one of them, which is where "is this one of the
         ones it is waiting for?" gets asked. */
      .field.is-missing-shared input:focus-visible {
        outline-color: #a8764a;
        outline-offset: 0;
      }

      /* Sat against the border rather than 2px clear of it: offset, a ring
         outside a border of the same colour reads as two borders on one box. */
      .field.is-missing input:focus-visible,
      .field.is-missing textarea:focus-visible,
      .field.is-missing select:focus-visible {
        outline-color: #a8764a;
        outline-offset: 0;
      }

      .option-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      /* Short options do not need a line each. The columns are equal and
         aligned rather than sized to their own text, so a four-answer question
         reads as a block instead of a ragged edge - and the list is capped
         short of the form's full width, which is what put two options a third
         of the page apart when they were stretched across it.

         auto-fit rather than a breakpoint: a row too narrow for two columns of
         a usable width gets one per line on its own, which is what a phone
         gets. */
      .option-list-inline {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        column-gap: 2rem;
        row-gap: 0.8rem;
        align-items: start;
        max-width: 34rem;
      }

      .option-list label {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.95rem;
        color: #ccc;
        font-weight: 400;
      }

      .option-list input {
        margin-top: 0.25rem;
        flex-shrink: 0;
      }

      .option-text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .option-label {
        color: #dde1e7;
        font-weight: 600;
      }

      .option-example {
        font-size: 0.86rem;
        color: #888;
        font-weight: 400;
      }

      @media (prefers-reduced-motion: no-preference) {
        .file-trigger,
        .file-list :global(.file-remove) {
          transition: transform 0.12s ease, background 0.15s ease,
            border-color 0.15s ease, color 0.15s ease;
        }

        .file-trigger:active,
        .file-list :global(.file-remove:active) {
          transform: scale(0.96);
        }

        /* A field being marked, and unmarked the moment it is answered.
           Instant, the mark arrives with no sense of what put it there - and on
           the way out it is the difference between a field that was fixed and
           one that simply stopped being marked. */
        input[type="text"],
        input[type="email"],
        input[type="tel"],
        textarea,
        select {
          transition: border-color 0.2s ease, outline-color 0.2s ease;
        }

        legend.field-label {
          transition: color 0.2s ease;
        }

        /* Hidden until there is something to say, so it arrives rather than
           transitions - a keyframe is the only thing that animates an element
           on its way in from display: none. */
        .field-error:not([hidden]) {
          animation: field-mark-in 0.2s ease;
        }

        @keyframes field-mark-in {
          from { opacity: 0; transform: translateY(-3px); }
          to { opacity: 1; transform: none; }
        }
      }
</style>
