---
import Layout from '../layouts/Layout.astro';
import { t } from '../data/translations.js';
import { BASE_FIELDS, PRINT_ONLY_FIELD_IDS } from '../data/intakeForm.js';
import { ArrowLeft } from 'lucide-astro';
import IntakeField from './IntakeField.astro';

interface Props {
  lang: 'en' | 'no';
}

const { lang } = Astro.props;
const tr = t[lang];
const td = tr.threeDPrintingIntake;
const backHref = lang === 'no' ? '/no/3d-printing' : '/3d-printing';

const byId = (id: string) => BASE_FIELDS.find(f => f.id === id);

const deliverableField = byId('deliverable');
const orderTypeField = byId('orderType');
const aboutFields = ['projectName', 'description', 'fileUpload'].map(byId);
const specFields = ['size', 'materialProperties', 'materialName', 'color', 'copyright'].map(byId);
const timingFields = ['quantity', 'targetDate', 'budget'].map(byId);
const contactFields = ['contactName', 'contactCompany', 'contactPhone', 'contactSignal', 'contactEmail', 'contactLocation', 'confidential'].map(byId);

// Single source for the dots, the "2 / 4" counter and the screen-reader
// announcement, so they cannot drift out of step with the actual stages.
const STAGE_IDS = ['stage-about', 'stage-spec', 'stage-timing', 'stage-contact'];
const stageLabels = {
  'stage-about': td.sectionAbout,
  'stage-spec': td.sectionSpec,
  'stage-timing': td.sectionTiming,
  'stage-contact': td.sectionContact,
};
---

<Layout
  lang={lang}
  title={td.title}
  description={td.description}
  altLangPath="/3d-printing/enquiry"
>
  <style>
    body {
      background: #1e2228;
      color: #dde1e7;
      font-family: 'Piazzolla', serif;
      min-height: 100vh;
    }

    main {
      max-width: 680px;
      margin: 0 auto;
      padding: 4rem 2rem 6.5rem;
    }

    .hero {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-family: 'Piazzolla', serif;
      font-size: 2.2rem;
      color: #fff;
      margin-bottom: 0.8rem;
      line-height: 1.15;
    }

    .intro {
      font-size: 1.02rem;
      line-height: 1.6;
      color: #ccc;
      text-align: center;
      margin-bottom: 3rem;
    }

    fieldset {
      border: none;
      padding: 0;
      margin: 0 0 2.5rem;
    }

    legend, .section-heading {
      font-size: 1.2rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 1.2rem;
      padding: 0;
    }

    .section-intro {
      font-size: 0.95rem;
      color: #aaa;
      margin: -0.6rem 0 1.2rem;
      line-height: 1.5;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    /* Progressive disclosure is between sections now, not within them: the
       page grows a section at a time instead of showing the whole form at
       once. */
    /* The two opening questions share a row. Their own .field margins do the
       vertical spacing, so there is no row-gap to double up with when this
       collapses to one column. */
    .question-pair {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: start;
    }

    @media (max-width: 620px) {
      .question-pair {
        grid-template-columns: 1fr;
      }
    }

    .continue-row {
      margin-top: 0.4rem;
    }

    .continue-btn {
      font-family: 'Piazzolla', serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: #dde1e7;
      background: transparent;
      border: 1px solid #4a5058;
      border-radius: 8px;
      padding: 0.6rem 1.4rem;
      cursor: pointer;
    }

    .continue-btn:hover:not(:disabled) {
      border-color: #6aaeee;
      color: #fff;
    }

    .continue-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    @media (prefers-reduced-motion: no-preference) {
      fieldset.stage {
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .stage-entering {
        opacity: 0;
        transform: translateY(8px);
      }

      /* A press should be felt, not just followed by something happening
         further down the page. */
      .continue-btn,
      button[type="submit"] {
        transition: transform 0.12s ease, background 0.15s ease,
          border-color 0.15s ease, color 0.15s ease;
      }

      .continue-btn:active,
      button[type="submit"]:active {
        transform: scale(0.97);
      }

      .form-error {
        animation: form-error-in 0.22s ease;
      }

      @keyframes form-error-in {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: none; }
      }
    }

    .submit-row {
      text-align: center;
      margin-top: 2.5rem;
    }

    /* The submit row is centred; a list of things to go and fix is not, so
       this block sets itself back to the left. */
    .form-error {
      font-size: 0.92rem;
      color: #f0907f;
      line-height: 1.45;
      margin: 0 0 1.2rem;
      text-align: left;
      background: #2b2126;
      border: 1px solid #7a4038;
      border-radius: 8px;
      padding: 0.8rem 1rem;
    }

    /* The heading, list and jump buttons are built by the script, so they carry
       no data-astro-cid and a plain scoped selector would miss them. They are
       :global(), anchored on the scoped container. */
    .form-error :global(.form-error-heading) {
      margin: 0;
      font-weight: 600;
    }

    /* Text presentation forced, so it does not arrive as a colour emoji. The
       wording carries the meaning on its own - this is decoration, which is
       why the colour is not the only signal. */
    .form-error :global(.form-error-heading::before) {
      content: '\26A0\FE0E';
      margin-right: 0.4rem;
    }

    .form-error :global(.form-error-list) {
      margin: 0.55rem 0 0;
      padding-left: 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    /* Each entry takes you to the field it names - the list is long enough on a
       phone that scrolling back to hunt for them would undo the point of it. */
    .form-error :global(.form-error-jump) {
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      color: inherit;
      text-align: left;
      text-decoration: underline;
      cursor: pointer;
    }

    .form-error :global(.form-error-jump:hover) {
      color: #fff;
    }

    button[type="submit"] {
      font-family: 'Piazzolla', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #1e2228;
      background: #6aaeee;
      border: none;
      border-radius: 8px;
      padding: 0.8rem 2rem;
      cursor: pointer;
    }

    button[type="submit"]:hover {
      background: #85bcf2;
    }

    .submit-note {
      font-size: 0.85rem;
      color: #888;
      margin-top: 0.8rem;
    }

    /* Purely visual cue that the form has more stages ahead - the intro
       already says so in words, this just makes it legible at a glance.
       Fixed to the bottom of the viewport so it stays visible as the page
       grows, rather than scrolling out of view above the current stage. */
    .progress-dots {
      position: fixed;
      left: 50%;
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      display: flex;
      gap: 0.55rem;
      margin: 0;
      padding: 0.55rem 0.9rem;
      background: rgba(30, 34, 40, 0.85);
      backdrop-filter: blur(4px);
      border: 1px solid #3a3f47;
      border-radius: 999px;
      z-index: 100;
    }

    .progress-dots .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: transparent;
      border: 1.5px solid #4a5058;
    }

    .progress-dots .dot.dot-active {
      background: #6aaeee;
      border-color: #6aaeee;
    }

    .progress-dots .dot.dot-done {
      background: #4a5058;
      border-color: #4a5058;
    }

    .back-home {
      position: fixed;
      top: calc(1rem - 4px);
      left: max(1rem, env(safe-area-inset-left, 0px) + 0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0.75;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .back-home:hover { opacity: 1; color: #fff; }

    @media (max-width: 720px) {
      main { padding: 2.5rem 1.25rem 4.5rem; }
      h1 { font-size: 1.8rem; }
    }  </style>

  <a class="back-home" href={backHref} aria-label={tr.backHomeAria}><ArrowLeft size={28} strokeWidth={1.5} /></a>

  <main id="main">
    <section class="hero">
      <h1>{td.h1}</h1>
      <p class="intro">{td.intro}</p>
    </section>

    <div class="progress-dots" aria-hidden="true">
      {STAGE_IDS.map(id => <span class="dot" data-dot={id}></span>)}
    </div>

    <!-- The dots are decorative; this is how a screen reader hears a stage change. -->
    <p class="visually-hidden" id="stage-announce" aria-live="polite"></p>

    <form id="intake-form" method="post" enctype="multipart/form-data" novalidate>
      <!--
        Honeypot: real visitors never see or fill this. A submission that
        arrives with it non-empty is worth dropping server-side - the check
        has to happen at the receiving endpoint, this form only carries the
        field.
      -->
      <input type="hidden" name="lang" value={lang} />

      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <fieldset id="stage-about" class="stage" tabindex="-1">
        <legend class="section-heading">{td.sectionAbout}</legend>

        <div class="question-pair">
          <IntakeField field={deliverableField} lang={lang} td={td} />
          <IntakeField field={orderTypeField} lang={lang} td={td} />
        </div>
        <input type="hidden" name="deliverable[]" value="model" id="deliverable-model-implied" disabled />

        {aboutFields.map(field => <IntakeField field={field} lang={lang} td={td} />)}

        <div class="continue-row">
          <button type="button" class="continue-btn" data-continue="about">{td.continueLabel}</button>
        </div>
      </fieldset>

      <fieldset id="stage-spec" class="stage" tabindex="-1" hidden>
        <legend class="section-heading">{td.sectionSpec}</legend>
        {specFields.map(field => <IntakeField field={field} lang={lang} td={td} />)}
        <div class="continue-row">
          <button type="button" class="continue-btn" data-continue="spec">{td.continueLabel}</button>
        </div>
      </fieldset>

      <fieldset id="stage-timing" class="stage" tabindex="-1" hidden>
        <legend class="section-heading">{td.sectionTiming}</legend>
        {timingFields.map(field => <IntakeField field={field} lang={lang} td={td} />)}
        <div class="continue-row">
          <button type="button" class="continue-btn" data-continue="timing">{td.continueLabel}</button>
        </div>
      </fieldset>

      <fieldset id="stage-contact" class="stage" tabindex="-1" hidden>
        <legend class="section-heading">{td.sectionContact}</legend>
        <!--
          Phone, Signal and email are each optional on their own but one of
          the three is required. Without this line the only statement of that
          rule was a validation message at the very end of the form, under
          three fields all labelled "(optional)".
        -->
        <p class="section-intro">{td.sectionContactIntro}</p>
        {contactFields.map(field => <IntakeField field={field} lang={lang} td={td} />)}

        <div class="submit-row">
          <!--
            Send stays clickable. A disabled submit button explains nothing,
            and the native validation bubble it would otherwise rely on is
            styled by the browser, written in the browser's UI language rather
            than the page's, and gone on the next scroll.
          -->
          <div class="form-error" id="submit-error" role="alert" hidden></div>
          <button type="submit">{td.submitLabel}</button>
          <p class="submit-note">{td.submitNote}</p>
        </div>
      </fieldset>
    </form>
  </main>

  <script define:vars={{ printOnlyFieldIds: PRINT_ONLY_FIELD_IDS, stageIds: STAGE_IDS, stageLabels, contactMethodRequired: td.contactMethodRequired, deliverableRequired: td.deliverableRequired, modelTickedNote: td.modelTickedNote, fileTooLarge: td.fileTooLarge, chooseFilesLabel: td.chooseFilesLabel, addFilesLabel: td.addFilesLabel, removeFileLabel: td.removeFileLabel, submitSummaryHeading: td.submitSummaryHeading, requiredFieldNote: td.requiredFieldNote, invalidEmailMessage: td.invalidEmailMessage, numberLocale: lang === 'no' ? 'nb-NO' : 'en-GB' }}>
    const form = document.getElementById('intake-form');

    // Declared up here because syncDeliverable() runs during setup and clears
    // field marks through it - left further down with the rest of the submit
    // handling, it was still in its temporal dead zone and the whole script
    // died on load.
    let reportedControls = [];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reports whether it actually revealed anything, so callers can move
    // focus on the first reveal only. Re-answering the deliverable or
    // order-type question from further down the form used to yank focus (and
    // with it, on a phone, the on-screen keyboard) back up to a section the
    // visitor had already passed.
    function reveal(el) {
      if (!el || !el.hidden) return false;
      el.hidden = false;
      if (!prefersReducedMotion) {
        el.classList.add('stage-entering');
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('stage-entering')));
      }
      return true;
    }

    // Focus the revealed container (each carries tabindex="-1"), not the
    // first field inside it. Focusing a text input opens the keyboard the
    // instant a radio is tapped, and the first field is not always visible:
    // quantity is hidden on the model-only path, and focus() on a hidden
    // element silently does nothing, which dropped keyboard users back at the
    // top of the document. preventScroll keeps focus from fighting the smooth
    // scroll in advance().
    function focusContainer(el) {
      el.focus({ preventScroll: true });
    }

    const stageAnnounce = document.getElementById('stage-announce');
    const dots = Object.fromEntries(stageIds.map(id => [id, document.querySelector('[data-dot="' + id + '"]')]));

    function setActiveStage(stageId, announce) {
      const activeIndex = stageIds.indexOf(stageId);
      stageIds.forEach((id, i) => {
        const dot = dots[id];
        if (!dot) return;
        dot.classList.remove('dot-done', 'dot-active');
        if (i < activeIndex) dot.classList.add('dot-done');
        else if (i === activeIndex) dot.classList.add('dot-active');
      });
      // Only on a real stage change - announcing on page load would talk over
      // the heading a screen reader is already reading.
      if (announce) stageAnnounce.textContent = stageLabels[stageId] + ', ' + (activeIndex + 1) + ' / ' + stageIds.length;
    }

    setActiveStage('stage-about', false);

    function advance(button, nextStage) {
      const row = button.closest('.continue-row');
      if (row) row.hidden = true;
      reveal(nextStage);
      nextStage.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
      focusContainer(nextStage);
      setActiveStage(nextStage.id, true);
    }

    const stageAbout = document.getElementById('stage-about');
    const stageSpec = document.getElementById('stage-spec');
    const stageTiming = document.getElementById('stage-timing');
    const stageContact = document.getElementById('stage-contact');

    const continueAbout = form.querySelector('[data-continue="about"]');
    const continueSpec = form.querySelector('[data-continue="spec"]');
    const continueTiming = form.querySelector('[data-continue="timing"]');

    const deliverableBoxes = Array.from(
      form.querySelectorAll('input[type="checkbox"][name="deliverable[]"]')
    );
    const printedBox = deliverableBoxes.find(box => box.value === 'printed');
    const modelBox = deliverableBoxes.find(box => box.value === 'model');
    const modelImplied = document.getElementById('deliverable-model-implied');
    const modelNote = modelBox.closest('label').querySelector('.option-example');

    // Remembers whether the model was wanted on its own, so unticking the part
    // puts the box back as the visitor left it rather than leaving behind a
    // tick they never made.
    let modelWantedAlone = false;

    // A group of checkboxes has no native "at least one" rule the way a radio
    // group does, so it gets the same treatment as the contact methods: the
    // message is parked on the first box for the submit handler to find.
    function validateDeliverable() {
      const anyTicked = printedBox.checked || modelBox.checked;
      printedBox.setCustomValidity(anyTicked ? '' : deliverableRequired);
    }

    // A print includes its model, so ticking the part ticks the model and then
    // locks it. Leaving it undoable was the confusing part of an earlier
    // version: not the tick appearing, but not knowing whether it was allowed
    // to be removed.
    function syncDeliverable(changed) {
      if (changed === modelBox) modelWantedAlone = modelBox.checked;

      const printing = printedBox.checked;
      if (printing) {
        const wasUnticked = !modelBox.checked;
        modelBox.checked = true;
        modelBox.disabled = true;
        // The note explains the greyed tick, so it belongs with the greyed
        // tick - there is nothing for it to say while the box is a live choice.
        if (modelNote) modelNote.classList.add('is-shown');
        // Greying it out removes it from the tab order, so a screen reader
        // never meets it. Announce the one thing seeing it would have told you.
        if (changed && wasUnticked) stageAnnounce.textContent = modelTickedNote;
      } else {
        modelBox.disabled = false;
        modelBox.checked = modelWantedAlone;
        if (modelNote) modelNote.classList.remove('is-shown');
      }

      // A disabled control submits nothing, so the implied value rides in the
      // hidden field while the visible one is locked.
      modelImplied.disabled = !printing;

      validateDeliverable();
      updateDeliverableFields();
      clearFieldErrorIfResolved(printedBox);
    }

    // Print-only fields don't apply when nothing is being printed. They are
    // hidden and disabled rather than cleared: a disabled control is barred
    // from constraint validation and left out of the submitted FormData, so
    // someone wanting only the model is not gated on quantity (required once
    // there is a print) and no stale material or quantity value rides along -
    // while anything already typed survives ticking the box again.
    function updateDeliverableFields() {
      const printing = printedBox.checked;
      printOnlyFieldIds.forEach(id => {
        const wrapper = form.querySelector('[data-field="' + id + '"]');
        if (!wrapper) return;
        wrapper.hidden = !printing;
        wrapper.querySelectorAll('input, select, textarea').forEach(control => {
          control.disabled = !printing;
        });
      });
    }

    form.addEventListener('change', (event) => {
      if (event.target.name === 'deliverable[]') syncDeliverable(event.target);
    });

    syncDeliverable(null);

    continueAbout.addEventListener('click', () => advance(continueAbout, stageSpec));
    continueSpec.addEventListener('click', () => advance(continueSpec, stageTiming));
    continueTiming.addEventListener('click', () => advance(continueTiming, stageContact));

    // None of phone/Signal/email is individually required - one of the three
    // is. The message is parked on the email field so reportValidity() has
    // somewhere to show it.
    const emailField = document.getElementById('contactEmail');
    const phoneField = document.getElementById('contactPhone');
    const contactSignalField = document.getElementById('contactSignal');

    function validateContactMethod() {
      const hasContact = emailField.value.trim() || phoneField.value.trim() || contactSignalField.value.trim();
      emailField.setCustomValidity(hasContact ? '' : contactMethodRequired);
    }

    emailField.addEventListener('input', validateContactMethod);
    phoneField.addEventListener('input', validateContactMethod);
    contactSignalField.addEventListener('input', validateContactMethod);
    validateContactMethod();

    // Client-side only: a courtesy check against the advertised cap, not a
    // real limit - the endpoint still has to enforce this on what it
    // actually receives.
    const MAX_FILE_BYTES = 10 * 1024 * 1024;
    const fileInput = document.getElementById('fileUpload');
    const fileList = document.getElementById('fileUpload-list');
    const fileError = document.getElementById('fileUpload-error');
    const fileTrigger = document.getElementById('fileUpload-trigger');
    const fileFallbackNote = document.getElementById('fileUpload-fallback');

    // A file input replaces its entire selection every time the picker is
    // used, so a second go silently drops the first. Rebuilding the FileList
    // through a DataTransfer is the only way to add to a selection or take a
    // single file out of it, and it keeps the input carrying exactly what the
    // list shows - so a plain form POST still sends the right set.
    const canRebuildFileList = (() => {
      try {
        const probe = new DataTransfer();
        probe.items.add(new File(['probe'], 'probe.txt'));
        return probe.files.length === 1;
      } catch (error) {
        return false;
      }
    })();

    // Without it there is nothing to offer but the native replace-the-lot
    // behaviour, so say that rather than showing a Remove button that cannot
    // work.
    if (!canRebuildFileList) fileFallbackNote.hidden = false;

    const sizeFormat = new Intl.NumberFormat(numberLocale, { maximumFractionDigits: 1 });

    function formatSize(bytes) {
      if (bytes < 1024) return sizeFormat.format(bytes) + ' B';
      if (bytes < 1024 * 1024) return sizeFormat.format(bytes / 1024) + ' kB';
      return sizeFormat.format(bytes / (1024 * 1024)) + ' MB';
    }

    // Same name, size and timestamp is the same file picked twice.
    const fileKey = file => file.name + ':' + file.size + ':' + file.lastModified;

    let selectedFiles = [];

    function writeBackToInput() {
      if (!canRebuildFileList) return;
      const transfer = new DataTransfer();
      selectedFiles.forEach(file => transfer.items.add(file));
      fileInput.files = transfer.files;
    }

    function removeFile(file) {
      const index = selectedFiles.indexOf(file);
      selectedFiles = selectedFiles.filter(entry => entry !== file);
      writeBackToInput();
      renderFileList();
      // The button that had focus no longer exists. Land on the row that took
      // its place, or back on the picker once the list empties, rather than
      // dropping focus to the top of the document.
      const buttons = fileList.querySelectorAll('.file-remove');
      if (buttons.length) buttons[Math.min(index, buttons.length - 1)].focus();
      else fileInput.focus();
    }

    function renderFileList() {
      // Built here rather than in the template, so these elements carry no
      // data-astro-cid - their rules are :global(), anchored on the scoped
      // .file-list in IntakeField.astro.
      fileList.textContent = '';

      selectedFiles.forEach(file => {
        const row = document.createElement('li');
        row.className = 'file-row';
        if (file.size > MAX_FILE_BYTES) row.classList.add('file-row-over');

        const name = document.createElement('span');
        name.className = 'file-name';
        name.textContent = file.name;

        const size = document.createElement('span');
        size.className = 'file-size';
        size.textContent = formatSize(file.size);

        row.append(name, size);

        if (canRebuildFileList) {
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'file-remove';
          remove.textContent = '\u00d7';
          remove.setAttribute('aria-label', removeFileLabel.replace('{file}', file.name));
          remove.addEventListener('click', () => removeFile(file));
          row.append(remove);
        }

        fileList.append(row);
      });

      fileList.hidden = selectedFiles.length === 0;
      fileTrigger.textContent = selectedFiles.length && canRebuildFileList ? addFilesLabel : chooseFilesLabel;

      // The input is clipped to 1px so the trigger label can carry Norwegian
      // text, which means a native validation bubble aimed at it lands on
      // something nobody can see. The custom validity still locks Continue
      // (wireContinue checks every control, not just the required ones); the
      // flagged row and the error line are what the visitor actually reads.
      const oversized = selectedFiles.some(file => file.size > MAX_FILE_BYTES);
      fileInput.setCustomValidity(oversized ? fileTooLarge : '');
      fileError.hidden = !oversized;
      fileError.textContent = oversized ? fileTooLarge : '';

      // A removal is a click, not an input or change event, so the listeners
      // that normally clear a warning would not fire.
      clearSubmitErrorIfResolved();
    }

    fileInput.addEventListener('change', () => {
      const picked = Array.from(fileInput.files);
      if (canRebuildFileList) {
        const seen = new Set(selectedFiles.map(fileKey));
        picked.forEach(file => {
          if (seen.has(fileKey(file))) return;
          seen.add(fileKey(file));
          selectedFiles.push(file);
        });
      } else {
        selectedFiles = picked;
      }
      writeBackToInput();
      renderFileList();
    });

    // Nothing in the form is gated: Continue always moves on, and Send is the
    // only thing that refuses. So Send has to say what it is waiting for, in
    // full - it is the first and only point at which anything is asked for.
    const submitError = document.getElementById('submit-error');

    function labelFor(control) {
      let source = control.id ? form.querySelector('label[for="' + control.id + '"]') : null;
      // Radio and checkbox groups are labelled by their fieldset's legend.
      if (!source) {
        const group = control.closest('fieldset');
        source = group ? group.querySelector('legend') : null;
      }
      if (!source) return '';
      return source.textContent.trim();
    }

    // setCustomValidity messages are ours already and say more than a field
    // name could - the contact-method rule, the deliverable rule and the file
    // size cap all land here.
    function summaryTextFor(control) {
      if (control.validity.customError) return control.validationMessage;
      if (control.validity.typeMismatch) return invalidEmailMessage;
      return labelFor(control);
    }

    // Beside the field itself the label would just repeat what is written above
    // it, so a plain note does instead.
    function inlineTextFor(control) {
      if (control.validity.customError) return control.validationMessage;
      if (control.validity.typeMismatch) return invalidEmailMessage;
      return requiredFieldNote;
    }

    // Every control that is standing between the visitor and sending, not just
    // the first. Nothing is gated on the way through the form any more, so
    // pressing Send is the first moment anything is asked for - reporting one
    // item at a time would mean pressing it once per missing answer.
    function invalidControls() {
      const seen = new Set();
      const found = [];
      // Disabled controls are barred from validation, so the print-only fields
      // drop out of this on a model-only enquiry without special-casing.
      form.querySelectorAll('input, select, textarea').forEach(control => {
        if (control.checkValidity()) return;
        // A radio or checkbox group is one answer, however many inputs it has.
        const key = control.type === 'radio' || control.type === 'checkbox'
          ? control.name
          : control.id || control.name;
        if (seen.has(key)) return;
        seen.add(key);
        found.push(control);
      });
      return found;
    }

    function goTo(control) {
      // Scroll to the row, not the control: the file input is clipped to 1px
      // and would put the viewport somewhere useless.
      (control.closest('.field') || control).scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'center',
      });
      control.focus({ preventScroll: true });
    }

    function fieldErrorFor(control) {
      const row = control.closest('.field');
      return row ? row.querySelector('.field-error') : null;
    }

    // Marks each offending field where it sits, and lists them all by the
    // button. The list is the part that answers "what do I have to fill in",
    // which is the question Send is being pressed to ask.
    function showSubmitErrors(controls) {
      reportedControls = controls;
      submitError.textContent = '';

      const heading = document.createElement('p');
      heading.className = 'form-error-heading';
      heading.textContent = submitSummaryHeading;

      const list = document.createElement('ul');
      list.className = 'form-error-list';

      controls.forEach(control => {
        const entry = document.createElement('li');
        const jump = document.createElement('button');
        jump.type = 'button';
        jump.className = 'form-error-jump';
        jump.textContent = summaryTextFor(control);
        jump.addEventListener('click', () => goTo(control));
        entry.append(jump);
        list.append(entry);

        const inline = fieldErrorFor(control);
        if (inline) {
          inline.textContent = inlineTextFor(control);
          inline.hidden = false;
        }
      });

      submitError.append(heading, list);
      submitError.hidden = false;
    }

    function clearSubmitError() {
      reportedControls.forEach(control => {
        const inline = fieldErrorFor(control);
        if (inline && inline.id !== 'fileUpload-error') {
          inline.hidden = true;
          inline.textContent = '';
        }
      });
      reportedControls = [];
      submitError.hidden = true;
      submitError.textContent = '';
    }

    // One field being fixed should clear that field's own mark straight away,
    // without waiting for the rest.
    function clearFieldErrorIfResolved(control) {
      if (!reportedControls.includes(control)) return;
      if (!control.checkValidity()) return;
      const inline = fieldErrorFor(control);
      if (inline && inline.id !== 'fileUpload-error') {
        inline.hidden = true;
        inline.textContent = '';
      }
    }

    // Stub: no endpoint is wired up yet. See issue #2 for the mail-based
    // delivery design; this only needs to exist so the form is testable.
    // method and enctype are set on the form already so that wiring it up
    // later is one action attribute, not a silent switch to a urlencoded
    // POST that drops every attachment.
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const invalid = invalidControls();
      if (invalid.length) {
        clearSubmitError();
        showSubmitErrors(invalid);
        // The list is right by the button, where the visitor is already
        // looking, so stay put unless the first thing missing is somewhere
        // they have scrolled past.
        if (!stageContact.contains(invalid[0])) goTo(invalid[0]);
        else invalid[0].focus({ preventScroll: true });
        return;
      }
      clearSubmitError();
      console.log('Intake form submit is stubbed - no endpoint connected yet.', new FormData(form));
    });

    // The whole warning goes once everything it listed has been answered; a
    // single field being fixed only clears its own mark. The list does not
    // shrink item by item while someone is typing - it is a record of what was
    // asked for, not a live tally.
    function clearSubmitErrorIfResolved() {
      if (submitError.hidden) return;
      if (reportedControls.every(control => !control.isConnected || control.checkValidity())) {
        clearSubmitError();
      }
    }
    form.addEventListener('input', (event) => {
      clearFieldErrorIfResolved(event.target);
      clearSubmitErrorIfResolved();
    });
    form.addEventListener('change', (event) => {
      clearFieldErrorIfResolved(event.target);
      clearSubmitErrorIfResolved();
    });
  </script>
</Layout>
