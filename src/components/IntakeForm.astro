---
import Layout from '../layouts/Layout.astro';
import { t } from '../data/translations.js';
import { BASE_FIELDS } from '../data/intakeForm.js';
import { ArrowLeft, ArrowUp } from 'lucide-astro';
import IntakeField from './IntakeField.astro';

interface Props {
  lang: 'en' | 'no';
}

const { lang } = Astro.props;
const tr = t[lang];
const td = tr.threeDPrintingIntake;
const backHref = lang === 'no' ? '/no/3d-printing' : '/3d-printing';

const byId = (id: string) => BASE_FIELDS.find(f => f.id === id);

// Field id -> the examples it offers, in this language. Handed to the script so
// the pick happens per visit rather than per build: a static site built once a
// week would otherwise show the same "random" example all week.
const PLACEHOLDER_SETS = Object.fromEntries(
  BASE_FIELDS.filter((field: any) => field.placeholders).map((field: any) => [field.id, field.placeholders[lang]]),
);

const aboutFields = ['projectName', 'description', 'fileUpload'].map(byId);
// Ownership follows what you have, because the two are one subject: where the
// design came from. It sat last, after the size, the material and the colour -
// the questions about the printed object rather than about the design - which
// put the one question on this form with legal weight at the bottom of the card,
// read last and answered last.
const specRows = [
  ['orderType'],
  ['copyright'],
  ['size', 'quantity'],
  ['materialProperties'],
  ['materialName', 'color'],
].map(row => row.map(byId));
// Fields grouped onto rows. A size, a quantity, a date, a budget bracket, a
// name, a company, a phone number and a town are all short values, and a box
// the width of the page invites a sentence - so they pair off, and only the ones
// that can genuinely run long stay wide.
//
// How many is a question about the part, not about when it is wanted: what it
// costs and how long it takes do not scale with it in a straight line, which is
// something to work out alongside size and material. So it sits with those,
// beside the size, and Timing is left with the two questions that really are
// about time and money.
const timingRows = [
  ['targetDate', 'budget'],
].map(row => row.map(byId));
// Paired across, read down: who you are on the left - name, company, town -
// and how to reach you on the right. The rows are what the grid fills, so the
// pairing here is horizontal and the two columns are the result.
const contactRows = [
  ['contactName', 'contactPhone'],
  ['contactCompany', 'contactEmail'],
  ['contactLocation', 'contactSignal'],
].map(row => row.map(byId));

// The one question that is not about reaching you, and the last thing before
// Send - so it shares Send's row rather than holding one of its own above it.
// A lone checkbox on a row of its own, with the button on the next row, spent
// two rows and a gap on one line of text and one button.
const confidentialField = byId('confidential');


// Single source for the dots, the "2 / 4" counter and the screen-reader
// announcement, so they cannot drift out of step with the actual stages.
const STAGE_IDS = ['stage-about', 'stage-spec', 'stage-timing', 'stage-contact'];
const stageLabels = {
  'stage-about': td.sectionAbout,
  'stage-spec': td.sectionSpec,
  'stage-timing': td.sectionTiming,
  'stage-contact': td.sectionContact,
};
---

<Layout
  lang={lang}
  title={td.title}
  description={td.description}
  altLangPath="/3d-printing/enquiry"
>
  <style>
    body {
      /* So the platform draws its own furniture dark: the list a select pops
         open, the caret, the scrollbars. Without it a dark page hangs a white
         dropdown off a dark control, which is the part of a select nothing in
         our CSS can reach. */
      color-scheme: dark;
      background: #1e2228;
      color: #dde1e7;
      font-family: 'Piazzolla', serif;
      min-height: 100vh;
    }

    main {
      max-width: 680px;
      margin: 0 auto;
      padding: 4rem 2rem 4rem;
    }

    .hero {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-family: 'Piazzolla', serif;
      font-size: 2.2rem;
      color: #fff;
      margin-bottom: 0.8rem;
      line-height: 1.15;
    }

    .intro {
      font-size: 1.02rem;
      line-height: 1.6;
      color: #ccc;
      text-align: center;
      margin-bottom: 1.5rem;
    }

    fieldset {
      border: none;
      padding: 0;
      margin: 0 0 2.5rem;
    }

    /* Each section is a card. The form is long, and a single column of fields
       on one flat background gave nothing to navigate by when scrolling back
       through it - the sections were only separated by empty space, which reads
       as more of the same. */
    fieldset.stage {
      background: #23272e;
      border: 1px solid #333840;
      border-radius: 12px;
      padding: 1.6rem 1.6rem 1.8rem;
      margin: 0 0 1.5rem;
    }

    /* Not a bigger, bolder version of a question label - a different kind of
       text altogether. Competing on size was the problem: 1.2rem/700 above a
       question legend at 1.1rem/600 is a tenth of a rem and a shade of grey,
       which is not a hierarchy. Small, spaced and in the page accent instead,
       so it reads as the name of the block rather than as the loudest question
       in it. */
    .section-heading {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: #6aaeee;
      margin: 0 0 1.4rem;
      padding: 0;
    }

    .section-intro {
      font-size: 0.95rem;
      color: #aaa;
      margin: -0.6rem 0 1.2rem;
      line-height: 1.5;
    }

    /* One heading over each column of a paired section, centred on the column
       it names. It is a row of the same grid the fields below use, so the two
       stay lined up at every width and stack together when the row collapses. */
    .column-headings {
      margin-bottom: 0.2rem;
    }

    /* Left, over the column it names - a heading centred over a column of
       left-aligned fields lines up with nothing in it. A row rather than a block
       so the dot beside the heading sits on its line the way the ones beside the
       field labels do. */
    .column-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin: 0 0 0.9rem;
    }

    /* The same dot as the one beside a required field label, drawn again here
       because scoped styles do not cross components: that rule lives in
       IntakeField.astro and would never match a span this file renders. */
    .column-heading .required-mark {
      display: inline-block;
      position: relative;
      width: 0.9rem;
      height: 0.9rem;
      margin-left: 0.1rem;
      vertical-align: middle;
    }

    .column-heading .required-mark::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 0.3rem;
      height: 0.3rem;
      border-radius: 50%;
      background: #e8b775;
    }

    /* And gone once the three fields under it are marked, for the same reason
       the field dots go: a promise and the thing it promised, side by side, is
       one warning too many. The state lives on the fields, so the heading has to
       ask after them - which is what :has is for. */
    #stage-contact:has(.field.is-missing-shared) .column-heading .required-mark {
      display: none;
    }

    /* A heading with something to say when you ask it. The whole heading is the
       target rather than the dot beside it, which is too small to hover for.

       No underline under it: the dotted line is the conventional way of saying
       "there is an explanation here", and it also looked like a heading someone
       had underlined by accident. What is left to find it by is the cursor and
       the dot - and the rule is in the alert text anyway for anyone who presses
       Send without ever hovering anything. */
    .column-heading[title] {
      cursor: help;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    /* Progressive disclosure is between sections now, not within them: the
       page grows a section at a time instead of showing the whole form at
       once. */
    /* Fields that belong together share a row. Their own .field margins do the
       vertical spacing, so there is no row-gap to double up with once a row
       collapses to a single column. */
    .field-row {
      display: grid;
      column-gap: 2rem;
      align-items: start;
    }

    /* auto-fit rather than a viewport breakpoint: the row pairs whenever there
       is room for two columns of a usable width and stacks when there is not,
       measured against the space it actually has. A media query asks the wrong
       question - it reads the viewport, which is not the same as the width this
       row was given, and which browser zoom and a high-DPI display both shrink
       out from under it. A 1280px screen at 250% zoom is 512 CSS pixels. */
    .field-row-2 {
      grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    }

    .field-row-3 {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    /* Progress on the left, the button on the right. flex-end rather than
       space-between, with the dots pushing themselves left: on every card but
       the one you are on the dots are hidden, and space-between would then walk
       the button over to the left where nothing else on the page sits. */
    .continue-row,
    .submit-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
    }

    /* Centre, which is what was asked for: the tick's line on the middle of the
       button's height. Baseline was tried in between and is the wrong answer
       here - it hangs a 22px line off the same line as the label of a 44px
       button, so the tick rides high. */
    .submit-actions {
      align-items: center;
    }

    /* Wrapping, because a tick with a sentence on it and a button are a lot for
       one narrow row: the button drops under the tick rather than squeezing it.
       The field pushes itself left so it stays there either way. */
    .submit-actions {
      flex-wrap: wrap;
      row-gap: 1.2rem;
    }

    /* :global on .field, because the field is IntakeField's markup and carries
       that component's scope - written plainly, this selector had IntakeForm's
       cid appended to .field and matched nothing at all. That is why the tick
       and the button sat packed together against the right of the row with a
       hole to their left: with no basis and no grow, the field was as wide as
       its own text and justify-content: flex-end put the pair at the end.
       The same mistake, unnoticed, is why the tick's bottom margin never went
       away either.

       A basis rather than auto: it states what the tick's side of the row wants
       instead of asking the field how wide its contents are. It grows into
       whatever is left, so the button is pushed right without a margin doing it,
       and 18rem is the width below which the two stop sharing a row. */
    .submit-actions :global(.field) {
      flex: 1 1 18rem;
      margin-bottom: 0;
    }

    /* The tick's box on the centre of its own line, not 0.25rem below the top of
       it. That offset is for options whose text runs to two lines, where a box
       centred on the block would float beside the middle of a paragraph - there
       is no second line here, and next to a button twice the height it was the
       one thing in the row not sitting on the same line as everything else.

       :global on the descendants: the option markup belongs to IntakeField, so
       it carries that component's scope and a selector written here would never
       reach it. The anchor is scoped, the rest is not. */
    .submit-actions :global(.option-list label) {
      align-items: center;
    }

    /* No margin at all, not just no top margin: a checkbox carries about 4px of
       it on the left from the browser's own stylesheet, which inset the tick
       from the card's edge while every input above it started flush against
       it. */
    .submit-actions :global(.option-list input) {
      margin: 0;
    }

    .continue-row {
      margin-top: 0.4rem;
    }

    /* Same trap as .progress-dots[hidden] above: display on the class beats the
       [hidden] attribute's own display: none, which lives in the browser's
       stylesheet and loses to anything of ours. advance() hides the row it came
       from, and the row stayed put - so every card you had passed kept offering
       to take you on to the next one. */
    .continue-row[hidden] {
      display: none;
    }

    .continue-btn {
      font-family: 'Piazzolla', serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: #dde1e7;
      background: transparent;
      border: 1px solid #4a5058;
      border-radius: 8px;
      padding: 0.6rem 1.4rem;
      cursor: pointer;
    }

    .continue-btn:hover:not(:disabled) {
      border-color: #6aaeee;
      color: #fff;
    }

    .continue-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    @media (prefers-reduced-motion: no-preference) {
      fieldset.stage {
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .stage-entering {
        opacity: 0;
        transform: translateY(8px);
      }

      /* A press should be felt, not just followed by something happening
         further down the page. */
      .continue-btn,
      button[type="submit"] {
        transition: transform 0.12s ease, background 0.15s ease,
          border-color 0.15s ease, color 0.15s ease;
      }

      /* A press that did not go through. Short, and once - it says the button
         heard you and refused, not that something is wrong with the button. */
      button[type="submit"].is-refused {
        animation: submit-refused 0.3s ease;
      }

      @keyframes submit-refused {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-4px); }
        40% { transform: translateX(4px); }
        60% { transform: translateX(-3px); }
        80% { transform: translateX(2px); }
      }

      .continue-btn:active,
      button[type="submit"]:active {
        transform: scale(0.97);
      }

      .form-error {
        animation: form-error-in 0.22s ease;
      }

      /* The rule appearing beside the heading, the same way a field's own mark
         appears under it - they are one event and should look like one. */
      .section-head .section-intro:not([hidden]) {
        animation: form-error-in 0.22s ease;
      }

      /* A section's dot changing what it means: done, current, or holding the
         send up. Slower than the marks, because the dots are the thing you are
         not looking at - a change you catch out of the corner of your eye has
         to last long enough to be caught. */
      .progress-dots .dot {
        transition: background 0.25s ease, border-color 0.25s ease;
      }

      @keyframes form-error-in {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: none; }
      }
    }

    /* The rule that used to sit above the confidentiality tick sits above the
       whole row now, because the tick is in it: what it separates is the last
       question and the send from the questions about reaching you. */
    .submit-row {
      border-top: 1px solid #333840;
      margin-top: 1.3rem;
      padding-top: 1.3rem;
    }

    /* The warning belongs to the form above it, not to the button below it, so
       when it appears it moves up towards the last field and leaves the button
       its own space. Without a warning the button keeps the full gap. */
    .submit-row:has(.form-error:not([hidden]):not(.form-error-quiet)) {
      margin-top: 0.6rem;
    }

    /* One line, so the box is the width of that line rather than the width of
       the form - a sentence pinned to the left of a full-width panel is mostly
       empty panel. It sits over the button it belongs to, centred with it.
       Only an endpoint refusal is shown this way; see .form-error-quiet. */
    /* Centred, not pushed right. It used to sit hard against the right edge to
       line up with Send, which reads as alignment when the box is nearly as wide
       as the card and as a stray when it is one short sentence - and the
       shortest message here is the one that matters most, the send that did not
       go through. Centred, it belongs to the card rather than to the button. */
    .form-error {
      font-size: 0.92rem;
      color: #e8b775;
      line-height: 1.45;
      width: fit-content;
      max-width: 100%;
      margin: 0 auto 2rem;
      background: #2c2419;
      border: 1px solid #7a5a30;
      border-radius: 8px;
      padding: 0.7rem 1rem;
    }

    /* A refusal that the page has already shown: every missing field is marked
       and the page has moved to the first one, so the sentence is left in the
       alert region for a screen reader and taken off the screen. Not [hidden],
       which would take it out of the accessibility tree as well. */
    .form-error.form-error-quiet {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      border: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    /* Send while the form is not ready to send. Not blue plus amber: an amber
       ring around a blue fill with dark text on it put three colours on the one
       element that has to look like the thing you press. It gives up the fill
       instead and wears the state colour on its own, so there are two - and it
       goes back to blue the moment the last marked field is answered.

       It has to be a standing state rather than a flourish. Pressing Send takes
       you to the first missing field, so anything that only happens once happens
       while the button is scrolling off the screen. This is what is waiting when
       you come back down to press it again.

       An inset ring rather than a border: a border would change the button's
       size, and it would do it while the page is moving. */
    button[type="submit"].is-refused {
      background: transparent;
      color: #e8b775;
      box-shadow: inset 0 0 0 1px #a8764a;
    }

    button[type="submit"].is-refused:hover {
      background: rgba(168, 118, 74, 0.12);
    }

    /* The heading, list and jump buttons are built by the script, so they carry
       no data-astro-cid and a plain scoped selector would miss them. They are
       :global(), anchored on the scoped container. */
    .form-error :global(.form-error-heading) {
      margin: 0;
      font-weight: 600;
    }

    /* Text presentation forced, so it does not arrive as a colour emoji. The
       wording carries the meaning on its own - this is decoration, which is
       why the colour is not the only signal. */
    .form-error :global(.form-error-heading::before) {
      content: '\26A0\FE0E';
      margin-right: 0.4rem;
    }

    button[type="submit"] {
      font-family: 'Piazzolla', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #1e2228;
      background: #6aaeee;
      border: none;
      border-radius: 8px;
      padding: 0.8rem 2rem;
      cursor: pointer;
    }

    button[type="submit"]:hover {
      background: #85bcf2;
    }

    /* Deliberately quiet, and deliberately not a box. A confirmation competing
       with the page it replaced would be the loudest thing on a page whose job
       is now over. */
    .form-sent {
      margin: 3rem 0 4rem;
      outline: none;
    }

    .form-sent-line {
      font-size: 1.1rem;
      line-height: 1.5;
      text-align: center;
      margin: 0 0 3rem;
    }

    /* One card, not one per section. Four cards each holding a column of short
       answers left half the width empty four times over; the sections are
       divisions within one record, not four records. Rules between them carry
       the same grouping at a fraction of the furniture.

       Everything inside is created by script when the form is sent, and a
       script-created node does not carry this component's scope attribute - so
       a plain `.receipt-heading { }` here compiles to
       `.receipt-heading[data-astro-cid-...]` and matches nothing on the page.
       Hence :global() descendants of .receipt, which is in the markup and does
       carry the scope. A test that reads textContent cannot see the difference;
       check a computed style. */
    .receipt {
      background: #23272e;
      border: 1px solid #333840;
      border-radius: 12px;
      padding: 1.6rem 1.6rem 1.8rem;
    }

    .receipt :global(.receipt-section + .receipt-section) {
      border-top: 1px solid #333840;
      margin-top: 1.8rem;
      padding-top: 1.6rem;
    }

    .receipt :global(.receipt-heading) {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: #6aaeee;
      margin: 0 0 1.2rem;
    }

    /* Answers flow into as many columns as fit rather than one per line. Most of
       them are a word or a number, and a column of those down the left of a
       680px page is mostly empty page.

       auto-fit against a 13rem minimum, the same way the form's own rows pair
       up: two columns when there is room and one when there is not, measured
       against the space this actually has rather than the viewport. */
    .receipt :global(.receipt-list) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: 1.2rem 2rem;
      align-items: start;
      margin: 0;
    }

    /* An answer that runs long takes the full width instead of being squeezed
       into a column: the description, and any list of attachments. */
    .receipt :global(.receipt-item-wide) {
      grid-column: 1 / -1;
    }

    .receipt :global(dt) {
      font-size: 0.88rem;
      color: #9aa2ad;
      margin-bottom: 0.25rem;
    }

    .receipt :global(dd) {
      margin: 0;
      line-height: 1.5;
      /* The description is the one answer that can carry its own line breaks,
         and an attachment list is one file per line. */
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    /* A lone checkbox is a statement rather than a question with an answer, so
       its label is the whole row and there is nothing to put opposite it. */
    .receipt :global(.receipt-statement) {
      margin: 1.2rem 0 0;
      line-height: 1.5;
    }

    /* Where this card sits in the sequence, marked on the card itself. It was
       a bar fixed to the bottom of the viewport, which put it in the same place
       as the Continue button at the end of every card - two centred things at
       the bottom of the screen, overlapping each other more often than not.
       Read off the card it belongs to, the marker needs no script either: the
       card you are on is the last one there is, so its own position is the
       progress. */
    /* Where the form is asking you to press something: the same row as the
       button that moves you on. It has been three things now - a bar fixed to
       the window, a marker on every card, and this. Fixed meant floating chrome
       over the page and a collision with whatever else sat at the bottom
       centre; one per card said the same thing four times over. Here there is
       exactly one on the page, in the place you are already looking, and it
       scrolls with the form like everything else.

       No background, border or blur: it is not sitting on top of the page any
       more, so it does not need to hold itself apart from it. */
    .progress-dots {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin: 0 auto 0 0;
    }

    /* display on the class beats the [hidden] attribute's own display: none,
       which is in the browser's stylesheet and loses to anything of ours. So
       every card's set stayed on screen and the form counted itself four
       times. */
    .progress-dots[hidden] {
      display: none;
    }

    .progress-dots .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: transparent;
      border: 1.5px solid #4a5058;
    }

    .progress-dots .dot.dot-active {
      background: #6aaeee;
      border-color: #6aaeee;
    }

    .progress-dots .dot.dot-done {
      background: #4a5058;
      border-color: #4a5058;
    }

    /* A section with an answer still missing, in the same amber as the fields
       themselves. Last of the dot rules, so it wins over done and active: which
       section you are on matters less than which one is holding you up. */
    .progress-dots .dot.dot-missing {
      background: #a8764a;
      border-color: #a8764a;
    }

    /* Copied from ThreeDPrintingPage.astro, where this page's visitors have
       just come from, and identical on the gallery, the projects list and every
       project page: same position, same fade, same 28px arrow. A back-to-top
       that looked or behaved differently here would be a different control as
       far as anyone using it is concerned.

       The bottom centre was the progress bar's until the dots moved into the
       rows, which is what left room for it. */
    .to-top {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      display: inline-flex;
      transform: translateX(-50%) translateY(0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .to-top.visible {
      opacity: 0.75;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .to-top:hover { opacity: 1; color: #fff; }

    .back-home {
      position: fixed;
      top: calc(1rem - 4px);
      left: max(1rem, env(safe-area-inset-left, 0px) + 0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0.75;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .back-home:hover { opacity: 1; color: #fff; }

    @media (max-width: 720px) {
      main { padding: 2.5rem 1.25rem 3rem; }
      h1 { font-size: 1.8rem; }
      /* A card on a phone is nearly the whole screen width, so its padding
         comes out of the room the fields have. */
      fieldset.stage { padding: 1.15rem 1.15rem 1.4rem; }
    }  </style>

  <a class="back-home" href={backHref} aria-label={tr.backHomeAria}><ArrowLeft size={28} strokeWidth={1.5} /></a>

  <main id="main">
    <section class="hero">
      <h1>{td.h1}</h1>
      <p class="intro">{td.intro}</p>
    </section>

    <!-- The dots are decorative; this is how a screen reader hears a stage change. -->
    <p class="visually-hidden" id="stage-announce" aria-live="polite"></p>

    <form id="intake-form" method="post" enctype="multipart/form-data" novalidate>
      <!--
        Honeypot: real visitors never see or fill this. A submission that
        arrives with it non-empty is worth dropping server-side - the check
        has to happen at the receiving endpoint, this form only carries the
        field.
      -->
      <input type="hidden" name="lang" value={lang} />

      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <fieldset id="stage-about" class="stage" tabindex="-1">
        <!--
          Kept for the fieldset and for screen readers, hidden from the page:
          the h1 two lines above already says "Fortell om delen din", so
          "Om delen" was the same words twice. The later headings are not
          redundant - they name different topics, and they arrive on their own
          after a Continue rather than under a title that already covers them.
        -->
        <legend class="visually-hidden">{td.sectionAbout}</legend>


        {aboutFields.map(field => <IntakeField field={field} lang={lang} td={td} />)}

        <div class="continue-row">
          <div class="progress-dots" aria-hidden="true">
            {STAGE_IDS.map(id => <span class="dot" data-dot={id}></span>)}
          </div>
          <button type="button" class="continue-btn" data-continue="about">{td.continueLabel}</button>
        </div>
      </fieldset>

      <fieldset id="stage-spec" class="stage" tabindex="-1" hidden>
        <legend class="visually-hidden">{td.sectionSpec}</legend>
        <!--
          The visible heading is a paragraph, not the legend: a legend inside a
          fieldset with a border is drawn into the border itself, which a card
          with rounded corners has nowhere sensible to put. The legend stays for
          the accessibility tree, so this copy is aria-hidden rather than read
          out twice.
        -->
        <p class="section-heading" aria-hidden="true">{td.sectionSpec}</p>
        {specRows.map(row => (
          <div class:list={['field-row', `field-row-${row.length}`]}>
            {row.map(field => <IntakeField field={field} lang={lang} td={td} />)}
          </div>
        ))}
        <div class="continue-row">
          <div class="progress-dots" aria-hidden="true">
            {STAGE_IDS.map(id => <span class="dot" data-dot={id}></span>)}
          </div>
          <button type="button" class="continue-btn" data-continue="spec">{td.continueLabel}</button>
        </div>
      </fieldset>

      <fieldset id="stage-timing" class="stage" tabindex="-1" hidden>
        <legend class="visually-hidden">{td.sectionTiming}</legend>
        <!--
          The visible heading is a paragraph, not the legend: a legend inside a
          fieldset with a border is drawn into the border itself, which a card
          with rounded corners has nowhere sensible to put. The legend stays for
          the accessibility tree, so this copy is aria-hidden rather than read
          out twice.
        -->
        <p class="section-heading" aria-hidden="true">{td.sectionTiming}</p>
        {timingRows.map(row => (
          <div class:list={['field-row', `field-row-${row.length}`]}>
            {row.map(field => <IntakeField field={field} lang={lang} td={td} />)}
          </div>
        ))}
        <div class="continue-row">
          <div class="progress-dots" aria-hidden="true">
            {STAGE_IDS.map(id => <span class="dot" data-dot={id}></span>)}
          </div>
          <button type="button" class="continue-btn" data-continue="timing">{td.continueLabel}</button>
        </div>
      </fieldset>

      <fieldset id="stage-contact" class="stage" tabindex="-1" hidden>
        <legend class="visually-hidden">{td.sectionContact}</legend>
        <!--
          The visible heading is a paragraph, not the legend: a legend inside a
          fieldset with a border is drawn into the border itself, which a card
          with rounded corners has nowhere sensible to put. The legend stays for
          the accessibility tree, so this copy is aria-hidden rather than read
          out twice.
        -->
        <!--
          Phone, Signal and email are each optional on their own but one of the
          three is required, and this is the only place that says so. It used to
          be said twice: here, and again in an amber line under the three fields
          once a send was refused - the same sentence, one of them phrased
          differently because it had to stand on its own.

          Now the rule is stated once and this line turns amber when it is the
          thing standing in the way (see .section-intro.is-missing). The fields
          themselves are marked at the same time, so what is being asked for and
          where to answer it are both on screen without either being repeated.

          It sits beside the heading rather than under it: the heading is two
          words and the line is one, and a row each spent two rows on what fits
          in one. It wraps back under when the row cannot hold both.

          A heading per column rather than one for the card, because the two
          columns are two different questions: who you are on the left, how to
          reach you on the right. They sit in a row of the same grid the fields
          use, so each one is centred over the column it names and stacks with it
          when the row collapses.

          The rule is the right column's heading's own tooltip. "Minst én av
          disse" needs something visible to point at, and a heading over the
          three of them is that; standing in the card as a line of its own it
          read as any one of the six fields being enough.

          The dot is back on the heading, and the tooltip is on the heading
          rather than on the dot: a 14px dot is a poor thing to have to hover.
          The dot belongs here and not on any of the three fields, which is the
          distinction - a mark means whatever it sits beside, so on a field label
          it says this field and on a column heading it says this column. One of
          these three is required, so the column is.

          A dotted underline is what says there is something to hover.

          A tooltip is for eyes and a mouse only, so the same rule goes into the
          alert text when a send is refused for it - in the wording that works
          without anything to point at. See contactMethodRequired.
        -->
        <div class="field-row field-row-2 column-headings">
          <p class="section-heading column-heading" aria-hidden="true">{td.sectionContact}</p>
          <p class="section-heading column-heading" aria-hidden="true" title={td.sectionContactIntro}>
            {td.columnContact}
            <span class="required-mark"></span>
          </p>
        </div>
        {contactRows.map(row => (
          <div class:list={['field-row', `field-row-${row.length}`]}>
            {row.map(field => <IntakeField field={field} lang={lang} td={td} />)}
          </div>
        ))}

        <div class="submit-row">
          <!--
            Send stays clickable. A disabled submit button explains nothing,
            and the native validation bubble it would otherwise rely on is
            styled by the browser, written in the browser's UI language rather
            than the page's, and gone on the next scroll.
          -->
          <div class="form-error" id="submit-error" role="alert" hidden></div>
          <!--
            No progress marker on this card. Four of four is where the form ends:
            the dots are there to say how much is left, and by here the answer is
            the button next to them. Their absence also leaves the row to the
            tick and to Send.
          -->
          <div class="submit-actions">
            <IntakeField field={confidentialField} lang={lang} td={td} />
            <button type="submit">{td.submitLabel}</button>
          </div>
        </div>
      </fieldset>
    </form>

    <!--
      What is left once the form goes. It sits outside the form so that hiding
      the form does not hide the confirmation with it, and it is a status rather
      than an alert: the visitor asked for this, so it does not need to
      interrupt them the way a refused submit does.
    -->
    <!--
      What replaces the form once it has gone. The receipt is built from the
      form's own controls rather than from a second copy of the answers, so it
      cannot drift from what was actually sent. role="status" sits on the line,
      not on the panel: a screen reader should hear "sent", then read the
      receipt at its own pace, rather than have the whole thing announced.
    -->
    <section class="form-sent" id="submit-done" tabindex="-1" hidden>
      <p class="form-sent-line" id="sent-message" role="status"></p>
      <div class="receipt" id="sent-receipt"></div>
    </section>
  </main>

  <a class="to-top" href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});this.classList.remove('visible');return false;" aria-label={tr.backTopAria}><ArrowUp size={28} strokeWidth={1.5} /></a>

  <script define:vars={{ stageIds: STAGE_IDS, stageLabels, contactMethodRequired: td.contactMethodRequired, fileTooLarge: td.fileTooLarge, chooseFilesLabel: td.chooseFilesLabel, addFilesLabel: td.addFilesLabel, removeFileLabel: td.removeFileLabel, submitMissingNote: td.submitMissingNote, placeholderSets: PLACEHOLDER_SETS, invalidEmailMessage: td.invalidEmailMessage, descriptionTooShort: td.descriptionTooShort, invalidPhoneMessage: td.invalidPhoneMessage, invalidSignalMessage: td.invalidSignalMessage, submitLabel: td.submitLabel, sendingLabel: td.sendingLabel, sentMessage: td.sentMessage, sendFailed: td.sendFailed, sendRateLimited: td.sendRateLimited, attachmentsTooLarge: td.attachmentsTooLarge, tooManyFiles: td.tooManyFiles, fileTypeRejected: td.fileTypeRejected, fileContentRejected: td.fileContentRejected, numberLocale: lang === 'no' ? 'nb-NO' : 'en-GB' }}>
    const form = document.getElementById('intake-form');

    // Shown only at the foot of the page, which is the rest of the site's rule
    // for it too. On this page the foot moves: every Continue adds a card, so
    // the arrow comes and goes as the form grows rather than sitting there from
    // the start.
    const toTop = document.querySelector('.to-top');
    window.addEventListener('scroll', () => {
      toTop.classList.toggle(
        'visible',
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 20,
      );
    });

    // One example out of the set, chosen on arrival. The markup already carries
    // the first of them, so this only ever swaps one example for another - a
    // visitor without script sees no difference, and nobody sees an empty box.
    Object.entries(placeholderSets).forEach(([id, examples]) => {
      const field = document.getElementById(id);
      if (!field || !examples.length) return;
      field.placeholder = examples[Math.floor(Math.random() * examples.length)];
    });

    // Declared up here, ahead of everything that touches it. It sat further
    // down with the rest of the submit handling once, and setup code running
    // before that met it in its temporal dead zone and killed the whole script
    // on load.
    let reportedControls = [];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reports whether it actually revealed anything, so callers can move
    // focus on the first reveal only. Re-answering a question from further down
    // the form used to yank focus (and with it, on a phone, the on-screen
    // keyboard) back up to a section the visitor had already passed.
    function reveal(el) {
      if (!el || !el.hidden) return false;
      el.hidden = false;
      if (!prefersReducedMotion) {
        el.classList.add('stage-entering');
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('stage-entering')));
      }
      return true;
    }

    // Focus the revealed container (each carries tabindex="-1"), not the
    // first field inside it. Focusing a text input opens the keyboard the
    // instant a radio is tapped, and the first field is not always visible:
    // quantity is hidden on the model-only path, and focus() on a hidden
    // element silently does nothing, which dropped keyboard users back at the
    // top of the document. preventScroll keeps focus from fighting the smooth
    // scroll in advance().
    function focusContainer(el) {
      el.focus({ preventScroll: true });
    }

    const stageAnnounce = document.getElementById('stage-announce');
    // One set per card, and only the card you are on shows its own. They all
    // say the same thing, so painting all of them costs nothing and means the
    // set that appears next is already right.
    const dotSets = Array.from(form.querySelectorAll('.progress-dots'));

    // Which sections are holding the send up, marked on the dots: with one set
    // on the page and four sections behind you, the dots are the only thing
    // that can say a section you have scrolled past is the problem.
    function paintMissingDots(controls) {
      const missing = new Set(
        controls.map(control => control.closest('fieldset.stage')).filter(Boolean).map(stage => stage.id),
      );
      dotSets.forEach(set => {
        stageIds.forEach(id => {
          const dot = set.querySelector('[data-dot="' + id + '"]');
          if (dot) dot.classList.toggle('dot-missing', missing.has(id));
        });
      });
    }

    function setActiveStage(stageId, announce) {
      const activeIndex = stageIds.indexOf(stageId);
      dotSets.forEach(set => {
        const stage = set.closest('fieldset.stage');
        set.hidden = !stage || stage.id !== stageId;
        stageIds.forEach((id, i) => {
          const dot = set.querySelector('[data-dot="' + id + '"]');
          if (!dot) return;
          dot.classList.remove('dot-done', 'dot-active');
          if (i < activeIndex) dot.classList.add('dot-done');
          else if (i === activeIndex) dot.classList.add('dot-active');
        });
      });
      // Only on a real stage change - announcing on page load would talk over
      // the heading a screen reader is already reading.
      if (announce) stageAnnounce.textContent = stageLabels[stageId] + ', ' + (activeIndex + 1) + ' / ' + stageIds.length;
    }

    setActiveStage('stage-about', false);

    function advance(button, nextStage) {
      const row = button.closest('.continue-row');
      if (row) row.hidden = true;
      reveal(nextStage);
      nextStage.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
      focusContainer(nextStage);
      setActiveStage(nextStage.id, true);
    }

    const stageAbout = document.getElementById('stage-about');
    const stageSpec = document.getElementById('stage-spec');
    const stageTiming = document.getElementById('stage-timing');
    const stageContact = document.getElementById('stage-contact');

    const continueAbout = form.querySelector('[data-continue="about"]');
    const continueSpec = form.querySelector('[data-continue="spec"]');
    const continueTiming = form.querySelector('[data-continue="timing"]');

    continueAbout.addEventListener('click', () => advance(continueAbout, stageSpec));
    continueSpec.addEventListener('click', () => advance(continueSpec, stageTiming));
    continueTiming.addEventListener('click', () => advance(continueTiming, stageContact));

    // None of phone/Signal/email is individually required - one of the three
    // is. The message is parked on the email field so reportValidity() has
    // somewhere to show it.
    const emailField = document.getElementById('contactEmail');
    const phoneField = document.getElementById('contactPhone');
    const contactSignalField = document.getElementById('contactSignal');

    // The same shape the endpoint insists on (workers/enquiry/index.js): an
    // address needs a dot-separated domain. type="email" on its own does not -
    // "konto@polybjorn" is a valid email input value, and the endpoint would
    // then refuse an enquiry over something the page could have caught while
    // the visitor was still standing in front of it. If one of these two
    // changes, the other has to change with it.
    const EMAIL_SHAPE = /^[^@\s]+@[^@\s.]+\.[^@\s]+$/;

    // Phone numbers vary too much between countries to check more than the
    // shape: take out the punctuation people actually type, then count digits.
    // E.164 caps a number at 15, and the shortest national numbers in use are
    // around 6, so anything outside that is a typo rather than a number.
    const PHONE_PUNCTUATION = /[\s().-]/g;
    const PHONE_SHAPE = /^\+?\d{6,15}$/;

    function phoneLooksRight(value) {
      return PHONE_SHAPE.test(value.replace(PHONE_PUNCTUATION, ''));
    }

    // The three ways Signal actually addresses someone: a signal.me link, a
    // username, or a phone number. A username carries its discriminator -
    // Signal requires the digits, so a bare word is not one, and someone typing
    // their display name here is giving me something I cannot reach them on.
    const SIGNAL_LINK = /^(https?:\/\/)?signal\.me\/\S+$/i;
    const SIGNAL_USERNAME = /^[a-z_][a-z0-9_]{2,31}\.\d{2,}$/i;

    function signalLooksRight(value) {
      return SIGNAL_LINK.test(value) || SIGNAL_USERNAME.test(value) || phoneLooksRight(value);
    }

    function validateContactMethod() {
      const email = emailField.value.trim();
      const phone = phoneField.value.trim();
      const signal = contactSignalField.value.trim();
      const hasContact = email || phone || signal;

      // Each of the three is optional, so a blank one says nothing and is left
      // alone. A filled-in one has to be something I can reach.
      phoneField.setCustomValidity(phone && !phoneLooksRight(phone) ? invalidPhoneMessage : '');
      contactSignalField.setCustomValidity(signal && !signalLooksRight(signal) ? invalidSignalMessage : '');

      if (!hasContact) emailField.setCustomValidity(contactMethodRequired);
      else if (email && !EMAIL_SHAPE.test(email)) emailField.setCustomValidity(invalidEmailMessage);
      else emailField.setCustomValidity('');
    }

    emailField.addEventListener('input', validateContactMethod);
    phoneField.addEventListener('input', validateContactMethod);
    contactSignalField.addEventListener('input', validateContactMethod);
    validateContactMethod();

    // Two characters is not a description, and a space is a value as far as
    // required is concerned - so an answer of " " satisfied it. Empty is left
    // to required itself: that is the plain "not answered yet" case, and it
    // gets the mark without a sentence like every other blank field.
    const DESCRIPTION_MIN = 12;
    const descriptionField = document.getElementById('description');

    function validateDescription() {
      const typed = descriptionField.value;
      const trimmed = typed.trim();
      const tooShort = typed.length > 0 && trimmed.length < DESCRIPTION_MIN;
      descriptionField.setCustomValidity(tooShort ? descriptionTooShort : '');
    }

    descriptionField.addEventListener('input', validateDescription);
    validateDescription();

    // Client-side only: a courtesy check against the advertised cap, not a
    // real limit - the endpoint still has to enforce this on what it
    // actually receives.
    const MAX_FILE_BYTES = 10 * 1024 * 1024;
    const fileInput = document.getElementById('fileUpload');
    const fileList = document.getElementById('fileUpload-list');
    const fileError = document.getElementById('fileUpload-error');
    const fileTrigger = document.getElementById('fileUpload-trigger');
    const fileFallbackNote = document.getElementById('fileUpload-fallback');

    // A file input replaces its entire selection every time the picker is
    // used, so a second go silently drops the first. Rebuilding the FileList
    // through a DataTransfer is the only way to add to a selection or take a
    // single file out of it, and it keeps the input carrying exactly what the
    // list shows - so a plain form POST still sends the right set.
    const canRebuildFileList = (() => {
      try {
        const probe = new DataTransfer();
        probe.items.add(new File(['probe'], 'probe.txt'));
        return probe.files.length === 1;
      } catch (error) {
        return false;
      }
    })();

    // Without it there is nothing to offer but the native replace-the-lot
    // behaviour, so say that rather than showing a Remove button that cannot
    // work.
    if (!canRebuildFileList) fileFallbackNote.hidden = false;

    const sizeFormat = new Intl.NumberFormat(numberLocale, { maximumFractionDigits: 1 });

    function formatSize(bytes) {
      if (bytes < 1024) return sizeFormat.format(bytes) + ' B';
      if (bytes < 1024 * 1024) return sizeFormat.format(bytes / 1024) + ' kB';
      return sizeFormat.format(bytes / (1024 * 1024)) + ' MB';
    }

    // Same name, size and timestamp is the same file picked twice.
    const fileKey = file => file.name + ':' + file.size + ':' + file.lastModified;

    let selectedFiles = [];

    function writeBackToInput() {
      if (!canRebuildFileList) return;
      const transfer = new DataTransfer();
      selectedFiles.forEach(file => transfer.items.add(file));
      fileInput.files = transfer.files;
    }

    function removeFile(file) {
      const index = selectedFiles.indexOf(file);
      selectedFiles = selectedFiles.filter(entry => entry !== file);
      writeBackToInput();
      renderFileList();
      // The button that had focus no longer exists. Land on the row that took
      // its place, or back on the picker once the list empties, rather than
      // dropping focus to the top of the document.
      const buttons = fileList.querySelectorAll('.file-remove');
      if (buttons.length) buttons[Math.min(index, buttons.length - 1)].focus();
      else fileInput.focus();
    }

    function renderFileList() {
      // Built here rather than in the template, so these elements carry no
      // data-astro-cid - their rules are :global(), anchored on the scoped
      // .file-list in IntakeField.astro.
      fileList.textContent = '';

      selectedFiles.forEach(file => {
        const row = document.createElement('li');
        row.className = 'file-row';
        if (file.size > MAX_FILE_BYTES) row.classList.add('file-row-over');

        const name = document.createElement('span');
        name.className = 'file-name';
        name.textContent = file.name;

        const size = document.createElement('span');
        size.className = 'file-size';
        size.textContent = formatSize(file.size);

        row.append(name, size);

        if (canRebuildFileList) {
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'file-remove';
          remove.textContent = '\u00d7';
          remove.setAttribute('aria-label', removeFileLabel.replace('{file}', file.name));
          remove.addEventListener('click', () => removeFile(file));
          row.append(remove);
        }

        fileList.append(row);
      });

      fileList.hidden = selectedFiles.length === 0;
      fileTrigger.textContent = selectedFiles.length && canRebuildFileList ? addFilesLabel : chooseFilesLabel;

      // The input is clipped to 1px so the trigger label can carry Norwegian
      // text, which means a native validation bubble aimed at it lands on
      // something nobody can see. The custom validity still locks Continue
      // (wireContinue checks every control, not just the required ones); the
      // flagged row and the error line are what the visitor actually reads.
      const oversized = selectedFiles.some(file => file.size > MAX_FILE_BYTES);
      fileInput.setCustomValidity(oversized ? fileTooLarge : '');
      fileError.hidden = !oversized;
      fileError.textContent = oversized ? fileTooLarge : '';

      // A removal is a click, not an input or change event, so the listeners
      // that normally clear a warning would not fire.
      clearSubmitErrorIfResolved();
    }

    fileInput.addEventListener('change', () => {
      const picked = Array.from(fileInput.files);
      if (canRebuildFileList) {
        const seen = new Set(selectedFiles.map(fileKey));
        picked.forEach(file => {
          if (seen.has(fileKey(file))) return;
          seen.add(fileKey(file));
          selectedFiles.push(file);
        });
      } else {
        selectedFiles = picked;
      }
      writeBackToInput();
      renderFileList();
    });

    // A dropdown drawn on the page rather than by the platform. A native
    // select's open list is not ours: its row height, font and width come from
    // the OS, so a control that matched the inputs beside it while closed
    // stopped matching the moment it opened, and no amount of CSS reaches
    // inside it.
    //
    // The <select> stays in the form and keeps the value, so what is submitted
    // is unchanged and the endpoint sees exactly what it saw before. Without
    // script none of this runs and the native control is what you get.
    form.querySelectorAll('.select-wrap').forEach(wrap => {
      const select = wrap.querySelector('select');
      const button = wrap.querySelector('.combo-button');
      const list = wrap.querySelector('.combo-list');
      const shown = wrap.querySelector('.combo-value');
      if (!select || !button || !list || !shown) return;
      const options = Array.from(list.querySelectorAll('.combo-option'));

      select.classList.add('combo-native-hidden');
      select.tabIndex = -1;
      select.setAttribute('aria-hidden', 'true');
      button.hidden = false;

      // The option the keyboard is on, which is not the option that is chosen:
      // moving through a list is not answering with everything you pass.
      let active = -1;

      function setActive(index, scroll) {
        active = index;
        options.forEach((option, i) => option.classList.toggle('is-active', i === index));
        if (index < 0) {
          button.removeAttribute('aria-activedescendant');
          return;
        }
        button.setAttribute('aria-activedescendant', options[index].id);
        if (scroll) options[index].scrollIntoView({ block: 'nearest' });
      }

      function open() {
        if (!list.hidden) return;
        list.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        // Opening lands on what is already chosen, or on the first option when
        // nothing is - not on nothing, which leaves the arrow keys with no
        // starting point.
        const chosen = options.findIndex(option => option.dataset.value === select.value);
        setActive(chosen >= 0 ? chosen : 0, true);
      }

      function close() {
        if (list.hidden) return;
        list.hidden = true;
        button.setAttribute('aria-expanded', 'false');
        setActive(-1);
      }

      function choose(index) {
        const option = options[index];
        if (!option) return;
        select.value = option.dataset.value;
        shown.textContent = option.textContent;
        shown.classList.add('has-value');
        options.forEach(other => other.setAttribute('aria-selected', String(other === option)));
        // Everything else on this page listens to the select, not to the button:
        // the validation, the marks and the warning all read the form's own
        // controls, so the value has to arrive there with an event on it.
        select.dispatchEvent(new Event('change', { bubbles: true }));
        close();
        button.focus();
      }

      button.addEventListener('click', () => (list.hidden ? open() : close()));

      button.addEventListener('keydown', (event) => {
        switch (event.key) {
          case 'ArrowDown':
            event.preventDefault();
            if (list.hidden) open();
            else setActive(Math.min(active + 1, options.length - 1), true);
            break;
          case 'ArrowUp':
            event.preventDefault();
            if (list.hidden) open();
            else setActive(Math.max(active - 1, 0), true);
            break;
          case 'Home':
            if (list.hidden) break;
            event.preventDefault();
            setActive(0, true);
            break;
          case 'End':
            if (list.hidden) break;
            event.preventDefault();
            setActive(options.length - 1, true);
            break;
          case 'Enter':
          case ' ':
            event.preventDefault();
            if (list.hidden) open();
            else choose(active);
            break;
          case 'Escape':
            if (list.hidden) break;
            event.preventDefault();
            close();
            break;
          case 'Tab':
            // Leaving is leaving: no silent choice on the way out.
            close();
            break;
        }
      });

      options.forEach((option, i) => {
        option.addEventListener('click', () => choose(i));
        // Pointer and keyboard share one highlight, so the list never shows a
        // hover in one place and an arrow key in another.
        option.addEventListener('mousemove', () => setActive(i, false));
      });

      document.addEventListener('click', (event) => {
        if (!wrap.contains(event.target)) close();
      });
    });

    // Nothing in the form is gated: Continue always moves on, and Send is the
    // only thing that refuses. What it says depends on what refused - see
    // showSubmitErrors for a form with answers missing, showSendFailure for an
    // endpoint that would not take it.
    const submitError = document.getElementById('submit-error');

    // Only a message that says something the summary does not. A field that is
    // simply missing gets no sentence of its own - the box is marked instead.
    // The list by the button has already named it, and repeating "needs an
    // answer" under every one of them turned a refused submit into a page of
    // warnings.
    function inlineTextFor(control) {
      if (control.validity.customError) return control.validationMessage;
      if (control.validity.typeMismatch) return invalidEmailMessage;
      return "";
    }

    // Where the field is, rather than what is wrong with it. A field answering
    // a rule it shares with others is marked differently - see the two classes
    // in IntakeField.astro: a field of its own gets a standing mark, a field of
    // a shared rule only reddens its focus ring, because any one of the three
    // answers the rule and three marked boxes read as three things to fill in.
    function markField(control, missing, shared) {
      const wrapper = control.closest(".field");
      if (!wrapper) return;
      wrapper.classList.toggle("is-missing", Boolean(missing) && !shared);
      wrapper.classList.toggle("is-missing-shared", Boolean(missing) && Boolean(shared));
    }

    // Every control that is standing between the visitor and sending, not just
    // the first. Nothing is gated on the way through the form any more, so
    // pressing Send is the first moment anything is asked for - reporting one
    // item at a time would mean pressing it once per missing answer.
    function invalidControls() {
      const seen = new Set();
      const found = [];
      // Disabled controls are barred from validation, so the print-only fields
      // drop out of this on a model-only enquiry without special-casing.
      form.querySelectorAll('input, select, textarea').forEach(control => {
        if (control.checkValidity()) return;
        // A radio or checkbox group is one answer, however many inputs it has.
        const key = control.type === 'radio' || control.type === 'checkbox'
          ? control.name
          : control.id || control.name;
        if (seen.has(key)) return;
        seen.add(key);
        found.push(control);
      });
      return found;
    }

    function goTo(control) {
      // Scroll to the row, not the control: the file input is clipped to 1px
      // and would put the viewport somewhere useless.
      (control.closest('.field') || control).scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'center',
      });
      control.focus({ preventScroll: true });
    }

    // The "at least one of three" rule is one question spread over three
    // fields, so it gets one mark under all three rather than one under
    // whichever field happens to carry the validity. Keyed by control name,
    // falling back to id, since a checkbox group is addressed by name and a
    // text field by either.
    // The three fields that answer one rule between them. It is a rule rather
    // than a field error, so it is not reported under any field: the section's
    // own line states it, and turns amber when it is the thing being waited for.
    const CONTACT_RULE_IDS = ['contactPhone', 'contactSignal', 'contactEmail'];

    function contactRuleFields() {
      return CONTACT_RULE_IDS.map(id => document.getElementById(id)).filter(Boolean);
    }

    // The rule, as opposed to something wrong with this field in particular. A
    // malformed number or address is the field's own business and says so under
    // it; "give me one of the three" belongs to all three at once and to none
    // of them individually.
    function isContactRule(control) {
      return CONTACT_RULE_IDS.includes(control.id)
        && control.validity.customError
        && control.validationMessage === contactMethodRequired;
    }

    function ownErrorFor(control) {
      const row = control.closest('.field');
      return row ? row.querySelector('.field-error') : null;
    }

    function wipeFieldError(control) {
      const slot = ownErrorFor(control);
      if (!slot || slot.id === 'fileUpload-error') return;
      slot.hidden = true;
      slot.textContent = '';
    }

    // invalidControls() reports one control per radio or checkbox group, so an
    // event from any other member of that group has to be mapped back to the
    // one that was actually reported - otherwise picking the second option of a
    // group never cleared the mark its first option had put up.
    function reportedControlFor(control) {
      // The field itself first: it may have been reported for something of its
      // own, and a shared rule must not answer for it.
      const direct = reportedControls.find(reported => reported === control
        || ((reported.type === 'radio' || reported.type === 'checkbox')
            && reported.name === control.name));
      if (direct) return direct;

      // Otherwise, answering any field of the contact rule answers the rule, so
      // an event from one of them is news about whichever control was reported
      // for it. Without this, filling in the phone number left all three marked
      // until the rest of the form happened to be finished too - the control
      // reported there is the email field, which nothing had typed in.
      if (CONTACT_RULE_IDS.includes(control.id)) {
        return reportedControls.find(reported => CONTACT_RULE_IDS.includes(reported.id)) || null;
      }
      return null;
    }

    // The rule's mark sits on three fields at once, so answering it takes the
    // mark off all three - but only where the field has nothing else wrong with
    // it. Clearing the lot unconditionally meant a corrected phone number also
    // unmarked an address that was still malformed.
    function unmark(control) {
      markField(control, false);
      if (!CONTACT_RULE_IDS.includes(control.id)) return;
      contactRuleFields().forEach(field => {
        if (field.checkValidity()) markField(field, false);
      });
    }

    // Marks each offending field where it sits and takes you to the first of
    // them; Send picks up a ring to say it was the press that refused. No
    // message: with the fields marked and the page moved to the first one, a
    // sentence by the button was saying what the page had already shown. It is
    // still written into the alert region, which is the only way a screen
    // reader hears any of this - hence the box being quietened rather than
    // skipped.
    //
    // An endpoint refusal is the other case, and it keeps the visible box:
    // rate-limited, a rejected file, no connection - none of that is a field
    // anyone can be sent to, so the sentence is all there is.
    function showSubmitErrors(controls) {
      reportedControls = controls;
      markSubmitRefused();
      paintMissingDots(controls);

      const heading = document.createElement('p');
      heading.className = 'form-error-heading';
      // The contact rule has no field of its own to be marked and its tooltip is
      // for a mouse, so where it is the thing being waited for it is said here
      // instead - in this box, which is the text a screen reader gets.
      heading.textContent = controls.some(isContactRule)
        ? submitMissingNote + ' ' + contactMethodRequired
        : submitMissingNote;

      controls.forEach(control => {
        // Phone, Signal and email are one rule spread over three fields, and
        // the line under them says it in words. Marking whichever box happens
        // to carry the validity would point at a field that is not itself
        // wrong - any one of the three answers it. A malformed address is not
        // that rule though: that one is the email field's own problem, so it
        // gets marked like anything else.
        if (isContactRule(control)) {
          // The rule is stated at the top of the section either way, so all
          // that changes is its colour. The three fields are marked with it,
          // which is what says where to answer it.
          contactRuleFields().forEach(field => markField(field, true, true));
        } else {
          markField(control, true);
          const inline = ownErrorFor(control);
          const text = inlineTextFor(control);
          if (inline && text) {
            inline.textContent = text;
            inline.hidden = false;
          }
        }
      });

      submitError.textContent = '';
      submitError.append(heading);
      submitError.classList.add('form-error-quiet');
      submitError.hidden = false;
    }

    // Send wears the same state whatever refused the press - a missing answer
    // here, or the endpoint turning the enquiry down. It said nothing about the
    // second, so a form that was filled in correctly and still would not send
    // left the button looking exactly as it does before anyone presses it.
    //
    // The class is taken off and put back so a second press moves the button
    // again: an animation already on the element does not restart by itself.
    function markSubmitRefused() {
      submitButton.classList.remove('is-refused');
      void submitButton.offsetWidth;
      submitButton.classList.add('is-refused');
    }

    function clearSubmitError() {
      reportedControls.forEach(control => {
        unmark(control);
        wipeFieldError(control);
      });
      reportedControls = [];
      paintMissingDots([]);
      submitButton.classList.remove('is-refused');
      submitError.hidden = true;
      submitError.classList.remove('form-error-quiet');
      submitError.textContent = '';
    }

    // One field being fixed should clear that field's own mark straight away,
    // without waiting for the rest.
    function clearFieldErrorIfResolved(control) {
      const reported = reportedControlFor(control);
      if (!reported || !reported.checkValidity()) return;
      unmark(reported);
      // A section stops being marked when nothing in it is outstanding any
      // more, not when the whole form is finally valid.
      paintMissingDots(reportedControls.filter(control => !control.checkValidity()));
      wipeFieldError(reported);
    }

    // The endpoint runs on this same hostname (a Cloudflare Worker route, see
    // workers/enquiry), so the request is same-origin: no CORS, and no other
    // host in the CSP. It parks the submission for pi-rovar to pull.
    const ENQUIRY_ENDPOINT = '/api/enquiry';
    const submitButton = form.querySelector('button[type="submit"]');
    const submitDone = document.getElementById('submit-done');
    const sentMessageEl = document.getElementById('sent-message');
    const sentReceipt = document.getElementById('sent-receipt');

    // The endpoint answers with a code rather than a sentence, so what a visitor
    // reads is written on this page, in the language they are reading it in.
    // Several of these are rules the form already states in its own words, and
    // they reuse that wording: a refusal should not be the first time someone
    // meets a different phrasing of the same rule.
    function messageForFailure(payload) {
      const file = payload && payload.file ? payload.file : '';
      switch (payload && payload.code) {
        case 'no-contact-method': return contactMethodRequired;
        case 'bad-email': return invalidEmailMessage;
        case 'file-too-large': return fileTooLarge;
        case 'too-large': return attachmentsTooLarge;
        case 'too-many-files': return tooManyFiles;
        case 'file-type': return fileTypeRejected.replace('{file}', file);
        case 'file-content': return fileContentRejected.replace('{file}', file);
        case 'rate-limited': return sendRateLimited;
        default: return sendFailed;
      }
    }

    // Not the same thing as the disabled Send button this form deliberately
    // does not have. That one would refuse to explain itself before there is
    // anything to explain; this one is off for the second or two when pressing
    // it again would only send the same enquiry twice.
    function setSending(sending) {
      submitButton.disabled = sending;
      submitButton.textContent = sending ? sendingLabel : submitLabel;
    }

    // The dots live in the form's own action rows now, so hiding the form takes
    // them with it.
    // Reads an answer back out of the control that holds it. The option text is
    // taken from .option-label rather than the whole <label>, so an answer comes
    // back as "Ferdig fil" and not as itself plus the example underneath it.
    function readAnswer(wrapper) {
      const label = wrapper.querySelector('.field-label');
      const labelText = label ? label.textContent.trim() : '';

      if (wrapper.dataset.field === 'fileUpload') {
        if (!selectedFiles.length) return null;
        return {
          label: labelText,
          value: selectedFiles.map(file => file.name + ' (' + formatSize(file.size) + ')').join('\n'),
        };
      }

      const optionText = input => {
        const own = input.closest('label');
        const named = own && own.querySelector('.option-label');
        return (named || own || input).textContent.trim();
      };

      const ticked = [...wrapper.querySelectorAll('input[type="radio"]:checked, input[type="checkbox"]:checked')]
        .filter(input => !input.disabled);
      if (ticked.length) {
        if (!labelText) return { statement: optionText(ticked[0]) };
        return { label: labelText, value: ticked.map(optionText).join(', ') };
      }

      const control = wrapper.querySelector('textarea, select, input[type="text"], input[type="email"], input[type="tel"]');
      if (!control || control.disabled) return null;
      // A select always has something selected, and on an unanswered one that
      // something is the placeholder. Its value is empty where its text is not,
      // so the value decides whether there is an answer and the text is only
      // what gets shown once there is one.
      const value = control.tagName === 'SELECT'
        ? (control.value.trim() ? control.options[control.selectedIndex].textContent.trim() : '')
        : control.value.trim();
      if (!value) return null;
      return { label: labelText, value };
    }

    // Built from the form itself rather than from a second copy of the answers,
    // so what someone reads back cannot drift from what FormData carried. Runs
    // before the form is hidden, while the controls still hold their values.
    // An answer long enough that a column would wrap it into a paragraph gets
    // the full width instead. Measured rather than listed by field id: a
    // description is always long and a colour is always short, but a material or
    // a deadline can be either, and the layout should follow what was typed.
    const WIDE_ANSWER_CHARS = 58;
    const isWide = answer => answer.value.includes('\n') || answer.value.length > WIDE_ANSWER_CHARS;

    function buildReceipt() {
      sentReceipt.textContent = '';

      stageIds.forEach(stageId => {
        const stage = document.getElementById(stageId);
        if (!stage) return;

        const answers = [];
        stage.querySelectorAll('[data-field]').forEach(wrapper => {
          if (wrapper.hidden) return;
          const answer = readAnswer(wrapper);
          if (answer) answers.push(answer);
        });
        if (!answers.length) return;

        const section = document.createElement('section');
        section.className = 'receipt-section';
        sentReceipt.append(section);

        const heading = document.createElement('h2');
        heading.className = 'receipt-heading';
        heading.textContent = stageLabels[stageId];
        section.append(heading);

        const list = document.createElement('dl');
        list.className = 'receipt-list';

        // A statement is not a term and a definition, so it does not go in the
        // list at all. There is one of them, it is the last question of its
        // section, and it reads as a closing line - which is where it lands.
        const statements = [];

        answers.forEach(answer => {
          if (answer.statement) {
            statements.push(answer.statement);
            return;
          }
          // Each pair wrapped so that the label and its value stay one grid
          // item. A bare dt and dd would be two, and the columns would pair
          // every label with the wrong answer.
          const item = document.createElement('div');
          item.className = isWide(answer) ? 'receipt-item receipt-item-wide' : 'receipt-item';
          const term = document.createElement('dt');
          term.textContent = answer.label;
          const value = document.createElement('dd');
          value.textContent = answer.value;
          item.append(term, value);
          list.append(item);
        });

        if (list.children.length) section.append(list);
        statements.forEach(text => {
          const line = document.createElement('p');
          line.className = 'receipt-statement';
          line.textContent = text;
          section.append(line);
        });
      });
    }

    function showSent() {
      buildReceipt();
      form.hidden = true;
      sentMessageEl.textContent = sentMessage;
      submitDone.hidden = false;
      submitDone.focus({ preventScroll: true });
      submitDone.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
    }

    function showSendFailure(message) {
      clearSubmitError();
      markSubmitRefused();
      const heading = document.createElement('p');
      heading.className = 'form-error-heading';
      heading.textContent = message;
      submitError.textContent = '';
      submitError.append(heading);
      submitError.classList.remove('form-error-quiet');
      submitError.hidden = false;
      submitError.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitButton.disabled) return;
      const invalid = invalidControls();
      if (invalid.length) {
        clearSubmitError();
        showSubmitErrors(invalid);
        // Nothing by the button explains itself any more, so the page always
        // goes to the field it is waiting for - including one in this last
        // section, which used to be left alone on the assumption that a message
        // beside the button covered it.
        goTo(invalid[0]);
        return;
      }
      clearSubmitError();
      setSending(true);

      try {
        const response = await fetch(ENQUIRY_ENDPOINT, {
          method: 'POST',
          body: new FormData(form),
          // Same-origin and no credentials: there is nothing here to
          // authenticate, and the endpoint sets no cookie.
          credentials: 'omit',
          headers: { accept: 'application/json' },
        });
        // A body that is not JSON means something other than the endpoint
        // answered - a proxy, an error page, a route that is not deployed yet -
        // and none of those are worth showing a visitor verbatim.
        const payload = await response.json().catch(() => null);
        if (response.ok && payload && payload.ok) {
          showSent();
          return;
        }
        showSendFailure(messageForFailure(payload));
      } catch {
        // Offline, or the request never landed. Either way there is nothing the
        // visitor can fix on the page, so the message offers the other way in.
        showSendFailure(sendFailed);
      } finally {
        setSending(false);
      }
    });

    // The whole warning goes once everything it listed has been answered; a
    // single field being fixed only clears its own mark. The list does not
    // shrink item by item while someone is typing - it is a record of what was
    // asked for, not a live tally.
    function clearSubmitErrorIfResolved() {
      if (submitError.hidden) return;
      if (reportedControls.every(control => !control.isConnected || control.checkValidity())) {
        clearSubmitError();
      }
    }
    form.addEventListener('input', (event) => {
      clearFieldErrorIfResolved(event.target);
      clearSubmitErrorIfResolved();
    });
    form.addEventListener('change', (event) => {
      clearFieldErrorIfResolved(event.target);
      clearSubmitErrorIfResolved();
    });
  </script>
</Layout>
