---
import Layout from '../layouts/Layout.astro';
import { t } from '../data/translations.js';
import { projects, cloudinaryUrl } from '../data/made.js';
import { Phone, Mail, MessageCircle, ArrowLeft, ArrowUp, Boxes, Lightbulb, Hammer, Layers, Wrench, GraduationCap } from 'lucide-astro';

interface Props {
  lang: 'en' | 'no';
}

const { lang } = Astro.props;
const tr = t[lang];
const td = tr.threeDPrinting;
const featured = projects.flatMap(p => p.images).filter(img => img.featured3D);
const backHref = lang === 'no' ? '/no' : '/';

const serviceOrder = [
  { key: 'modelling', icon: Boxes },
  { key: 'consultation', icon: Lightbulb },
  { key: 'prototyping', icon: Hammer },
  { key: 'smallBatch', icon: Layers },
  { key: 'support', icon: Wrench },
  { key: 'courses', icon: GraduationCap },
];
---

<Layout
  lang={lang}
  title={td.title}
  description={td.description}
  altLangPath="/3d-printing"
>
  <style>
    body {
      background: #1e2228;
      color: #dde1e7;
      font-family: 'Piazzolla', serif;
      min-height: 100vh;
    }

    main {
      max-width: 860px;
      margin: 0 auto;
      padding: 4rem 2rem 3rem;
    }

    .hero {
      text-align: center;
      margin-bottom: 4rem;
    }

    h1 {
      font-family: 'Piazzolla', serif;
      font-size: 2.6rem;
      color: #fff;
      margin-bottom: 0.8rem;
      line-height: 1.15;
    }

    .tagline {
      font-family: 'Piazzolla', serif;
      font-size: 1.15rem;
      color: #ccc;
      line-height: 1.6;
      max-width: 620px;
      margin: 0 auto;
    }

    section {
      margin-bottom: 3.5rem;
    }

    h2 {
      font-family: 'Piazzolla', serif;
      font-size: 1.5rem;
      color: #fff;
      font-weight: 700;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .service {
      background: #2a2e35;
      border-radius: 10px;
      padding: 1.4rem 1.5rem;
    }

    .service-head {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.6rem;
    }

    .service h3 {
      font-family: 'Piazzolla', serif;
      font-size: 1.1rem;
      color: #fff;
      font-weight: 700;
    }

    .service p {
      font-family: 'Piazzolla', serif;
      font-size: 0.98rem;
      color: #bbb;
      line-height: 1.55;
    }

    .service-icon {
      color: #E8A838;
      flex-shrink: 0;
    }

    .prose p {
      font-family: 'Piazzolla', serif;
      font-size: 1.05rem;
      line-height: 1.75;
      color: #ccc;
      margin-bottom: 1rem;
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
    }

    .prose p:last-child { margin-bottom: 0; }

    .examples-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .examples-grid .example {
      background: #2a2e35;
      border-radius: 8px;
      overflow: hidden;
      aspect-ratio: 1 / 1;
    }

    .examples-grid img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.2s;
    }

    .examples-grid a img:hover { opacity: 0.85; }

    .examples-more {
      font-family: 'Piazzolla', serif;
      text-align: center;
      color: #888;
      font-size: 0.95rem;
      margin-top: 1rem;
    }

    .examples-more a {
      color: #6aaeee;
      text-decoration: underline;
    }

    .contact-cta {
      text-align: center;
      padding: 2rem 1.5rem;
      background: #23272e;
      border-radius: 10px;
    }

    .contact-cta p {
      font-family: 'Piazzolla', serif;
      font-size: 1.1rem;
      color: #ccc;
      margin-bottom: 1.2rem;
    }

    .contact-row {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .contact-item {
      font-family: 'Piazzolla', serif;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #bbb;
      font-size: 1.05rem;
    }

    .contact-item a {
      color: #6aaeee;
      text-decoration: underline;
    }

    .contact-item svg { position: relative; top: 1px; }

    .back-home {
      position: fixed;
      top: calc(1rem - 4px);
      left: max(1rem, env(safe-area-inset-left, 0px) + 0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0.75;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .back-home:hover { opacity: 1; color: #fff; }
    .back-home.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.5rem);
    }

    .to-top {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      display: inline-flex;
      transform: translateX(-50%) translateY(0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .to-top.visible {
      opacity: 0.75;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .to-top:hover { opacity: 1; color: #fff; }

    @media (max-width: 720px) {
      main { padding: 2.5rem 1.25rem 2rem; }
      h1 { font-size: 1.9rem; }
      .tagline { font-size: 1rem; }
      .services { grid-template-columns: 1fr; gap: 1rem; }
      .service { padding: 1.2rem; }
      h2 { font-size: 1.3rem; }
      .examples-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
      .contact-row { gap: 1rem; flex-direction: column; align-items: center; }
    }
  </style>

  <a class="back-home" href={backHref} aria-label={tr.backHomeAria}><ArrowLeft size={28} strokeWidth={1.5} /></a>

  <main id="main">
    <section class="hero">
      <h1>{td.h1}</h1>
      <p class="tagline">{td.tagline}</p>
    </section>

    <section>
      <div class="examples-grid">
        {featured.map(img => (
          <div class="example">
            {img.link
              ? <a href={img.link} target="_blank" rel="noopener" aria-label={img.title}><img
                  src={cloudinaryUrl(img.url, { width: 600 })}
                  srcset={`${cloudinaryUrl(img.url, { width: 400 })} 400w, ${cloudinaryUrl(img.url, { width: 600 })} 600w, ${cloudinaryUrl(img.url, { width: 800 })} 800w`}
                  sizes="(max-width: 720px) 50vw, 25vw"
                  alt="" loading="lazy" /></a>
              : <img
                  src={cloudinaryUrl(img.url, { width: 600 })}
                  srcset={`${cloudinaryUrl(img.url, { width: 400 })} 400w, ${cloudinaryUrl(img.url, { width: 600 })} 600w, ${cloudinaryUrl(img.url, { width: 800 })} 800w`}
                  sizes="(max-width: 720px) 50vw, 25vw"
                  alt={img.alt} loading="lazy" />
            }
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>{td.servicesHeading}</h2>
      <div class="services">
        {serviceOrder.map(({ key, icon: Icon }) => (
          <div class="service">
            <div class="service-head">
              <Icon size={22} strokeWidth={1.5} class="service-icon" />
              <h3>{td.services[key].title}</h3>
            </div>
            <p>{td.services[key].body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="prose">
      <h2>{td.howItWorksHeading}</h2>
      <p>{td.howItWorks1}</p>
      <p>{td.howItWorks2}</p>
    </section>

    <section class="prose">
      <h2>{td.whoItsForHeading}</h2>
      <p>{td.whoItsFor1}</p>
      <p>{td.whoItsFor2}</p>
    </section>

    <section class="contact-cta">
      <p>{td.contactCta}</p>
      <div class="contact-row">
        <span class="contact-item"><Phone size={18} strokeWidth={1.5} style="color: #4CAF82;" /> <span id="phone"></span></span>
        <span class="contact-item">
          <MessageCircle size={18} strokeWidth={1.5} style="color: #6aaeee;" />
          <a href="https://signal.me/#eu/bjanda.60">{tr.signal}</a>
        </span>
        <span class="contact-item"><Mail size={18} strokeWidth={1.5} style="color: #E8A838;" /> <span id="email"></span></span>
      </div>
    </section>

    <section>
      <p class="examples-more" set:html={td.examplesMoreHtml}></p>
    </section>

  </main>

  <a class="to-top" href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});this.classList.remove('visible');return false;" aria-label={tr.backTopAria}><ArrowUp size={28} strokeWidth={1.5} /></a>

  <script>
    const phone = atob('KzQ3IDk2OSAxMSA1ODc=');
    const email = atob('cG9zdEBwb2x5Ympvcm4uY29t');
    document.getElementById('phone').textContent = phone;
    document.getElementById('email').textContent = email;

    const backHome = document.querySelector('.back-home');
    const scrollTop = document.querySelector('.to-top');
    window.addEventListener('scroll', () => {
      backHome.classList.toggle('hidden', window.scrollY > 60);
      scrollTop.classList.toggle('visible', window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 20);
    }, { passive: true });
  </script>
</Layout>
