---
import Layout from '../layouts/Layout.astro';
import { t } from '../data/translations.js';
import { projects, cloudinaryUrl } from '../data/made.js';
import { Phone, Mail, MessageCircle, KeyRound, ArrowLeft, ArrowUp, Boxes, Lightbulb, Hammer, Layers, Wrench, GraduationCap } from 'lucide-astro';

interface Props {
  lang: 'en' | 'no';
}

const { lang } = Astro.props;
const tr = t[lang];
const td = tr.threeDPrinting;
const featured = projects.flatMap(p => p.images).filter(img => img.featured3D);
const backHref = lang === 'no' ? '/no' : '/';
const enquiryHref = lang === 'no' ? '/no/3d-printing/enquiry' : '/3d-printing/enquiry';

const serviceOrder = [
  { key: 'modelling', icon: Boxes },
  { key: 'consultation', icon: Lightbulb },
  { key: 'prototyping', icon: Hammer },
  { key: 'smallBatch', icon: Layers },
  { key: 'support', icon: Wrench },
  { key: 'courses', icon: GraduationCap },
];
---

<Layout
  lang={lang}
  title={td.title}
  description={td.description}
  altLangPath="/3d-printing"
>
  <style>
    body {
      background: #1e2228;
      color: #dde1e7;
      font-family: 'Piazzolla', serif;
      min-height: 100vh;
    }

    main {
      max-width: 860px;
      margin: 0 auto;
      padding: 4rem 2rem 3rem;
    }

    .hero {
      text-align: center;
      margin-bottom: 4rem;
    }

    h1 {
      font-family: 'Piazzolla', serif;
      font-size: 2.6rem;
      color: #fff;
      margin-bottom: 0.8rem;
      line-height: 1.15;
    }

    .tagline {
      font-family: 'Piazzolla', serif;
      font-size: 1.15rem;
      color: #ccc;
      line-height: 1.6;
      max-width: 620px;
      margin: 0 auto;
    }

    section {
      margin-bottom: 3.5rem;
    }

    /* The same kind of text as the enquiry form's section headings, and for
       the reason that settled it there: at 1.5rem, white and centred, the one
       heading left on this page was a louder version of a service title rather
       than a different thing from it. Small, spaced and in the accent reads as
       the name of a block. */
    h2 {
      font-family: 'Piazzolla', serif;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: #6aaeee;
      margin-bottom: 1.2rem;
    }

    /* Hairlines, where the cards left empty space. A fill on this page means
       something can be pressed, so the cards had to go - but six short blocks
       separated by nothing but air read as one loose block, and the wider the
       gap grew the more it looked like the grid had come apart. The rule is the
       one the contact block already draws, so this introduces nothing new. */
    .services {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .service {
      padding: 1.4rem 1.6rem;
    }

    /* Only the sides that meet a rule are padded, so the block's outer edges
       line up with the heading above it and the page's other sections. */
    .service:nth-child(odd) {
      border-right: 1px solid #333840;
      padding-left: 0;
    }

    .service:nth-child(even) { padding-right: 0; }
    .service:nth-child(-n+2) { padding-top: 0; }
    .service:nth-last-child(-n+2) { padding-bottom: 0; }

    .service:not(:nth-last-child(-n+2)) {
      border-bottom: 1px solid #333840;
    }

    .service-head {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.6rem;
    }

    .service h3 {
      font-family: 'Piazzolla', serif;
      font-size: 1.1rem;
      color: #fff;
      font-weight: 700;
    }

    .service p {
      font-family: 'Piazzolla', serif;
      font-size: 0.98rem;
      color: #bbb;
      line-height: 1.55;
    }

    .service-icon {
      color: #E8A838;
      flex-shrink: 0;
    }

    .examples-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .examples-grid .example {
      border-radius: 8px;
      overflow: hidden;
      aspect-ratio: 1 / 1;
    }

    .examples-grid img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.2s;
    }

    .examples-grid a img:hover { opacity: 0.85; }

    .examples-more {
      font-family: 'Piazzolla', serif;
      color: #888;
      font-size: 0.95rem;
      margin-top: 0.9rem;
    }

    .examples-more a {
      color: #6aaeee;
      text-decoration: underline;
    }

    .enquiry-cta {
      font-family: 'Piazzolla', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #1e2228;
      background: #6aaeee;
      border-radius: 8px;
      padding: 0.8rem 2rem;
      text-decoration: none;
      display: inline-block;
    }

    .enquiry-cta:hover {
      background: #85bcf2;
    }

    @media (prefers-reduced-motion: no-preference) {
      .enquiry-cta {
        transition: background 0.15s, transform 0.12s;
      }

      .enquiry-cta:active {
        transform: scale(0.97);
      }
    }

    .contact-cta {
      text-align: center;
      padding: 2.2rem 0 0;
    }

    /* A connector between the button and the row under it, not a statement of
       its own - so it is quieter than either. */
    .contact-cta p {
      font-family: 'Piazzolla', serif;
      font-size: 1rem;
      color: #9aa2ad;
      margin: 1.4rem 0 1rem;
    }

    .contact-row {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .contact-item {
      font-family: 'Piazzolla', serif;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #bbb;
      font-size: 1.05rem;
    }

    .contact-item a {
      color: #6aaeee;
      text-decoration: underline;
    }

    .contact-item svg { position: relative; top: 1px; }

    /* A property of the address beside it, not a fourth way to reach me:
       nobody gets in touch "by PGP", and as a peer of Signal it read as a
       channel. Smaller than the address and set off by a wider gap than the
       item's own, so it attaches to the email rather than starting the next
       item. */
    .pgp {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-left: 0.4rem;
      font-size: 0.9em;
    }

    .back-home {
      position: fixed;
      top: calc(1rem - 4px);
      left: max(1rem, env(safe-area-inset-left, 0px) + 0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0.75;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .back-home:hover { opacity: 1; color: #fff; }
    .back-home.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.5rem);
    }

    .to-top {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      display: inline-flex;
      transform: translateX(-50%) translateY(0.5rem);
      color: #ccc;
      text-decoration: none;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      line-height: 1;
    }
    .to-top.visible {
      opacity: 0.75;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .to-top:hover { opacity: 1; color: #fff; }

    @media (max-width: 720px) {
      main { padding: 2.5rem 1.25rem 2rem; }
      h1 { font-size: 1.9rem; }
      .tagline { font-size: 1rem; }
      .services { grid-template-columns: 1fr; }
      .service, .service:nth-child(odd), .service:nth-child(even) {
        padding: 1.2rem 0;
        border-right: none;
      }
      .service:first-child { padding-top: 0; }
      .service:last-child { padding-bottom: 0; border-bottom: none; }
      .service:not(:last-child) { border-bottom: 1px solid #333840; }
      .examples-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
      .contact-row { gap: 1rem; flex-direction: column; align-items: center; }
    }
  </style>

  <a class="back-home" href={backHref} aria-label={tr.backHomeAria}><ArrowLeft size={28} strokeWidth={1.5} /></a>

  <main id="main">
    <section class="hero">
      <h1>{td.h1}</h1>
      <p class="tagline">{td.tagline}</p>
    </section>

    <section>
      <div class="examples-grid">
        {featured.map(img => (
          <div class="example">
            {img.link
              ? <a href={img.link} target="_blank" rel="noopener" aria-label={img.title}><img
                  src={cloudinaryUrl(img.url, { width: 600 })}
                  srcset={`${cloudinaryUrl(img.url, { width: 400 })} 400w, ${cloudinaryUrl(img.url, { width: 600 })} 600w, ${cloudinaryUrl(img.url, { width: 800 })} 800w`}
                  sizes="(max-width: 720px) 50vw, 25vw"
                  alt="" loading="lazy" /></a>
              : <img
                  src={cloudinaryUrl(img.url, { width: 600 })}
                  srcset={`${cloudinaryUrl(img.url, { width: 400 })} 400w, ${cloudinaryUrl(img.url, { width: 600 })} 600w, ${cloudinaryUrl(img.url, { width: 800 })} 800w`}
                  sizes="(max-width: 720px) 50vw, 25vw"
                  alt={img.alt} loading="lazy" />
            }
          </div>
        ))}
      </div>
      <p class="examples-more" set:html={td.examplesMoreHtml}></p>
    </section>

    <section>
      <h2>{td.servicesHeading}</h2>
      <div class="services">
        {serviceOrder.map(({ key, icon: Icon }) => (
          <div class="service">
            <div class="service-head">
              <Icon size={22} strokeWidth={1.5} class="service-icon" />
              <h3>{td.services[key].title}</h3>
            </div>
            <p>{td.services[key].body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="contact-cta">
      <a class="enquiry-cta" href={enquiryHref}>{td.enquiryCta}</a>
      <p>{td.contactCta}</p>
      <div class="contact-row">
        <span class="contact-item"><Phone size={18} strokeWidth={1.5} style="color: #4CAF82;" /> <span id="phone"></span></span>
        <span class="contact-item">
          <MessageCircle size={18} strokeWidth={1.5} style="color: #6aaeee;" />
          <a href="https://signal.me/#eu/bjanda.60">{tr.signal}</a>
        </span>
        <span class="contact-item"><Mail size={18} strokeWidth={1.5} style="color: #E8A838;" /> <span id="email"></span><span class="pgp"><KeyRound size={16} strokeWidth={1.5} style="color: #b08bd9;" /><a href="/pubkey.asc">PGP</a></span></span>
      </div>
    </section>

  </main>

  <a class="to-top" href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});this.classList.remove('visible');return false;" aria-label={tr.backTopAria}><ArrowUp size={28} strokeWidth={1.5} /></a>

  <script>
    const phone = atob('KzQ3IDk2OSAxMSA1ODc=');
    const email = atob('YW5kZXJzZW5AcG9seWJqb3JuLmNvbQ==');
    document.getElementById('phone').textContent = phone;
    document.getElementById('email').textContent = email;

    const backHome = document.querySelector('.back-home');
    const scrollTop = document.querySelector('.to-top');
    window.addEventListener('scroll', () => {
      backHome.classList.toggle('hidden', window.scrollY > 60);
      scrollTop.classList.toggle('visible', window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 20);
    }, { passive: true });
  </script>
</Layout>
