---
import '@fontsource/piazzolla/400.css';
import '@fontsource/piazzolla/700.css';
const { lang = 'en', title, description, image, noindex = false, altLangPath, enOnly = false, repo } = Astro.props;
const otherLang = lang === 'en' ? 'no' : 'en';
const path = Astro.url.pathname;
const stripped = lang === 'no' ? (path.replace(/^\/no/, '') || '/') : path;
const enPath = lang === 'no' ? (altLangPath ?? stripped) : path;
const noPath = lang === 'no' ? stripped : (altLangPath ?? path);
const enUrl = `https://polybjorn.com${enPath === '/' ? '' : enPath}`;
const noUrl = `https://polybjorn.no${noPath === '/' ? '' : noPath}`;
const canonicalUrl = lang === 'en' ? enUrl : noUrl;
const otherUrl = lang === 'en'
  ? noUrl
  : `${enUrl}?lang=en`;
const ogImage = image ?? 'https://res.cloudinary.com/djpkffk5u/image/upload/c_fill,g_center,w_1200,h_630/v1772729286/polybjorn-banner-navy-1500x500_rvluaz.png';

const schemas = [{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://polybjorn.com/#person",
  "name": "Bjørn A. Andersen",
  "alternateName": "Bjørn Andreas Andersen",
  "url": "https://polybjorn.com",
  "image": "https://res.cloudinary.com/det9ftymo/image/upload/c_pad,b_gen_fill,w_360,h_360/v1725405810/photo_jn86fv.jpg",
  "sameAs": [
    "https://grabcad.com/bjorn.a.andersen-1"
  ],
  "jobTitle": "3D Designer & Instructor",
  "description": "3D modelling, 3D printing, production, electronics and design services in Haugesund and Haugalandet, Norway.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Haugesund",
    "addressRegion": "Rogaland",
    "addressCountry": "NO"
  },
  "knowsAbout": ["3D modelling", "3D printing", "Additive manufacturing", "Graphic design", "Electronics", "Production"]
}, {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "3D Printing & Design Services",
  "description": "3D modelling, 3D printing, production and hands-on courses in Haugesund and Haugalandet, Norway.",
  "areaServed": ["Haugesund", "Haugalandet", "Rogaland"],
  "provider": { "@id": "https://polybjorn.com/#person" }
}];

if (lang === 'no' && !noindex) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": "https://polybjorn.no/#business",
    "name": "Bjørn A. Andersen",
    "legalName": "Polybjorn Andersen",
    "alternateName": ["Bjørn Andreas Andersen", "Polybjorn"],
    "url": "https://polybjorn.no",
    "image": "https://res.cloudinary.com/det9ftymo/image/upload/c_pad,b_gen_fill,w_360,h_360/v1725405810/photo_jn86fv.jpg",
    "description": "3D-printing, 3D-modellering, design og kurs i Haugesund og Haugalandet.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Haugesund",
      "addressRegion": "Rogaland",
      "addressCountry": "NO"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 59.4138, "longitude": 5.268 },
    "areaServed": ["Haugesund", "Karmøy", "Tysvær", "Sveio", "Bokn", "Vindafjord", "Haugalandet", "Rogaland"],
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "Organisasjonsnummer",
      "value": "925828513"
    },
    "founder": { "@id": "https://polybjorn.com/#person" }
  });
}
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="polybjorn" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e2228" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Bjørn Andreas Andersen" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    {!enOnly && <link rel="alternate" hreflang="no" href={noUrl} />}
    <link rel="alternate" hreflang="x-default" href="https://polybjorn.com" />
    {lang === 'en' && <link rel="alternate" type="application/rss+xml" title="Bjørn A. Andersen - Projects" href="https://polybjorn.com/projects/rss.xml" />}
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={lang === 'no' ? '2eb7ad17-e72b-4623-8ee8-7faf054587a8' : 'ed33a1a1-90f7-4f7b-8466-e6b0c74f5227'}
    />
    <slot name="head" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    </style>
    <style>
      :focus-visible {
        outline: 2px solid #6aaeee;
        outline-offset: 3px;
        border-radius: 2px;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        overflow-x: hidden;
      }
      html {
        scrollbar-gutter: stable;
      }
      /* One slot in the top right corner: the flag on pages that have a
         counterpart in the other language, the repository link on the ones
         that do not. Centred on 26.5px down the page either way, which is
         where the 21px-tall flag has always sat. */
      .corner-link {
        position: fixed;
        top: calc(1rem - 3.5px);
        right: 1rem;
        height: 28px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        z-index: 100;
        opacity: 0.75;
        transition: opacity 0.3s, transform 0.3s;
        line-height: 0;
        font-size: 0;
      }
      .repo-link { color: #ccc; }
      .repo-link:hover { color: #fff; }
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: #6aaeee;
        color: #1e2228;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-size: 0.9rem;
        font-family: 'Piazzolla', serif;
        text-decoration: none;
        z-index: 200;
      }
      .skip-link:focus {
        top: 1rem;
      }
      .corner-link:hover { opacity: 1; }
      .corner-link.hidden {
        opacity: 0;
        pointer-events: none;
        transform: translateY(-0.5rem);
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {enOnly ? repo && (
      <a class="corner-link repo-link" href={repo} target="_blank" rel="noopener" title="GitHub repository" aria-label="GitHub repository">
        <svg fill="currentColor" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:24px;height:24px;display:block;"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
    ) : (
      <a class="corner-link lang-toggle" href={otherUrl} title={otherLang === 'no' ? 'Norsk' : 'English'}>
        {otherLang === 'no' ? (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 480" style="width:28px;height:21px;display:block;border-radius:4px;">
            <path fill="#ed2939" d="M0 0h640v480H0z"/>
            <path fill="#fff" d="M180 0h120v480H180z"/>
            <path fill="#fff" d="M0 180h640v120H0z"/>
            <path fill="#002664" d="M210 0h60v480h-60z"/>
            <path fill="#002664" d="M0 210h640v60H0z"/>
          </svg>
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 640 480" style="width:28px;height:21px;display:block;border-radius:4px;">
            <defs>
              <g id="eu-d">
                <g id="eu-b">
                  <path id="eu-a" d="m0-1-.3 1 .5.1z"/>
                  <use xlink:href="#eu-a" transform="scale(-1 1)"/>
                </g>
                <g id="eu-c">
                  <use xlink:href="#eu-b" transform="rotate(72)"/>
                  <use xlink:href="#eu-b" transform="rotate(144)"/>
                </g>
                <use xlink:href="#eu-c" transform="scale(-1 1)"/>
              </g>
            </defs>
            <path fill="#039" d="M0 0h640v480H0z"/>
            <g fill="#fc0" transform="translate(320 242.3)scale(23.7037)">
              <use xlink:href="#eu-d" width="100%" height="100%" y="-6"/>
              <use xlink:href="#eu-d" width="100%" height="100%" y="6"/>
              <g id="eu-e">
                <use xlink:href="#eu-d" width="100%" height="100%" x="-6"/>
                <use xlink:href="#eu-d" width="100%" height="100%" transform="rotate(-144 -2.3 -2.1)"/>
                <use xlink:href="#eu-d" width="100%" height="100%" transform="rotate(144 -2.1 -2.3)"/>
                <use xlink:href="#eu-d" width="100%" height="100%" transform="rotate(72 -4.7 -2)"/>
                <use xlink:href="#eu-d" width="100%" height="100%" transform="rotate(72 -5 .5)"/>
              </g>
              <use xlink:href="#eu-e" width="100%" height="100%" transform="scale(-1 1)"/>
            </g>
          </svg>
        )}
      </a>
    )}
    <slot />
    <script>
      // The flag gets out of the way once you start reading. The repository
      // link stays: it is the article's own link, wanted at the end as much as
      // at the top, and there is no second copy of it further down the page.
      const corner = document.querySelector('.corner-link:not(.repo-link)');
      if (corner) {
        window.addEventListener('scroll', () => {
          corner.classList.toggle('hidden', window.scrollY > 60);
        }, { passive: true });
      }
    </script>
  </body>
</html>